---
import Logo from "../Icons/Logo.astro";
---

<header
    data-header
    class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-white/70 border-b border-black/5"
>
    <div class="max-w-6xl mx-auto px-5 sm:px-6 md:px-8 py-3 sm:py-4 flex items-center justify-between">
        <!-- Logo -->
        <a href="#hero" data-header-logo class="flex items-center">
            <Logo class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10" />
        </a>

        <!-- Navegación desktop -->
        <nav class="hidden md:flex items-center gap-6 lg:gap-10 text-sm text-gray-600 relative">
            <!-- Indicador hover estilo Tesla -->
            <div
                data-header-indicator
                class="absolute bg-gray-400/10 rounded-lg opacity-0 pointer-events-none"
                style="will-change: transform, width, height;"
            ></div>

            <a
                data-header-link
                href="#about"
                class="relative hover:text-black transition-colors duration-300 px-3 py-2"
                >Nosotros</a
            >
            <a
                data-header-link
                href="#services"
                class="relative hover:text-black transition-colors duration-300 px-3 py-2"
                >Servicios</a
            >
            <a
                data-header-link
                href="#projects"
                class="relative hover:text-black transition-colors duration-300 px-3 py-2"
                >Proyectos</a
            >
            <a
                data-header-link
                href="#contact"
                class="relative hover:text-black transition-colors duration-300 px-3 py-2"
                >Contacto</a
            >
        </nav>

        <!-- CTA -->
        <div class="hidden md:block">
            <a
                data-header-cta
                href="#contact"
                class="border border-black px-4 lg:px-5 py-2 rounded-full text-sm hover:bg-black hover:text-white transition-all duration-300"
            >
                Empezar
            </a>
        </div>

        <!-- Botón móvil -->
        <button
            data-header-mobile
            aria-label="Abrir menú"
            class="md:hidden w-10 h-10 flex items-center justify-center -mr-2"
        >
            <svg
                data-header-mobile-icon
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Menú móvil expandible -->
    <div
        data-header-menu
        class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-500 ease-out border-t border-transparent"
    >
        <nav class="px-5 sm:px-6 py-6 flex flex-col gap-1 text-base">
            <a
                data-header-menu-link
                href="#about"
                class="py-3 text-gray-700 hover:text-black border-b border-black/5 transition-colors"
                >Nosotros</a
            >
            <a
                data-header-menu-link
                href="#services"
                class="py-3 text-gray-700 hover:text-black border-b border-black/5 transition-colors"
                >Servicios</a
            >
            <a
                data-header-menu-link
                href="#projects"
                class="py-3 text-gray-700 hover:text-black border-b border-black/5 transition-colors"
                >Proyectos</a
            >
            <a
                data-header-menu-link
                href="#contact"
                class="py-3 text-gray-700 hover:text-black transition-colors"
                >Contacto</a
            >
            <a
                data-header-menu-link
                href="#contact"
                class="mt-4 inline-flex items-center justify-center bg-black text-white px-5 py-3 rounded-full text-sm hover:bg-gray-800 transition"
            >
                Empezar
            </a>
        </nav>
    </div>
</header>

<style>
    :global(html:not(.header-ready)) [data-header-logo],
    :global(html:not(.header-ready)) [data-header-link],
    :global(html:not(.header-ready)) [data-header-cta],
    :global(html:not(.header-ready)) [data-header-mobile] {
        visibility: hidden;
    }
</style>

<script>
    import { gsap } from "gsap";

    const header = document.querySelector<HTMLElement>("[data-header]");
    const logo = document.querySelector<HTMLElement>("[data-header-logo]");
    const links = document.querySelectorAll<HTMLElement>("[data-header-link]");
    const cta = document.querySelector<HTMLElement>("[data-header-cta]");
    const mobile = document.querySelector<HTMLElement>("[data-header-mobile]");
    const indicator = document.querySelector<HTMLElement>("[data-header-indicator]");

    gsap.set(header, { y: -80, opacity: 0 });
    gsap.set(logo, { opacity: 0, scale: 0.6, rotate: -90 });
    gsap.set(links, { opacity: 0, y: -12 });
    gsap.set([cta, mobile].filter(Boolean), { opacity: 0, y: -12 });
    document.documentElement.classList.add("header-ready");

    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    tl.to(header, { y: 0, opacity: 1, duration: 0.7 })
        .to(
            logo,
            {
                opacity: 1,
                scale: 1,
                rotate: 0,
                duration: 0.8,
                ease: "back.out(1.7)",
            },
            "-=0.4",
        )
        .to(links, { opacity: 1, y: 0, duration: 0.5, stagger: 0.08 }, "-=0.5")
        .to(
            [cta, mobile].filter(Boolean),
            { opacity: 1, y: 0, duration: 0.5 },
            "-=0.3",
        );

    // ========== INDICADOR HOVER ESTILO TESLA ==========
    // Div gris translúcido que se mueve detrás de los links siguiendo el cursor
    if (indicator && links.length > 0) {
        links.forEach((link) => {
            link.addEventListener("mouseenter", (e: MouseEvent) => {
                const target = e.currentTarget as HTMLElement;
                const rect = target.getBoundingClientRect();
                const nav = target.parentElement;
                const navRect = nav?.getBoundingClientRect();

                if (navRect) {
                    // Calcular posición relativa al nav
                    const x = rect.left - navRect.left;
                    const y = rect.top - navRect.top;

                    // Animar el indicador al tamaño y posición del link
                    gsap.to(indicator, {
                        x: x,
                        y: y,
                        width: rect.width,
                        height: rect.height,
                        opacity: 1,
                        duration: 0.3,
                        ease: "power2.out"
                    });
                }
            });
        });

        // Ocultar cuando el mouse sale de la navegación
        const nav = indicator.parentElement;
        nav?.addEventListener("mouseleave", () => {
            gsap.to(indicator, {
                opacity: 0,
                duration: 0.2,
                ease: "power2.out"
            });
        });
    }

    /**
     * Detecta si el viewport está cubriendo un Moment con sticky pin activo.
     * Un pin se considera "activo" cuando su top tocó el top del viewport
     * y su bottom todavía no salió por arriba (está ocupando la pantalla).
     */
    const isInsidePinnedMoment = () => {
        const pins = document.querySelectorAll<HTMLElement>(
            "[data-moment-pin]",
        );
        for (const pin of pins) {
            const r = pin.getBoundingClientRect();
            // El pin está activo si su top está en o por encima del viewport
            // y su bottom todavía cubre al menos parte de la pantalla
            if (r.top <= 1 && r.bottom > 100) return true;
        }
        return false;
    };

    let lastY = window.scrollY;
    let headerHidden = false;
    const hideHeader = () => {
        if (headerHidden) return;
        headerHidden = true;
        gsap.to(header, { y: -90, duration: 0.4, ease: "power2.out" });
    };
    const showHeader = () => {
        if (!headerHidden) return;
        headerHidden = false;
        gsap.to(header, { y: 0, duration: 0.4, ease: "power2.out" });
    };

    window.addEventListener("scroll", () => {
        const y = window.scrollY;
        if (!header) return;

        // Estado de fondo (con sombra) según scroll
        if (y > 40) {
            header.classList.add("is-scrolled");
        } else {
            header.classList.remove("is-scrolled");
        }

        // 1) Si estamos dentro de un Moment pinned → ocultar SIEMPRE
        // (independiente de la dirección de scroll)
        if (isInsidePinnedMoment()) {
            hideHeader();
        } else {
            // 2) Comportamiento normal fuera de los Moments:
            //    ocultar al scrollear hacia abajo, mostrar al scrollear hacia arriba
            if (y > lastY && y > 120) {
                hideHeader();
            } else {
                showHeader();
            }
        }
        lastY = y;
    });

    // Menú móvil
    const menu = document.querySelector<HTMLElement>("[data-header-menu]");
    const menuIcon = document.querySelector<SVGPathElement>(
        "[data-header-mobile-icon] path",
    );
    const menuLinks = document.querySelectorAll<HTMLElement>(
        "[data-header-menu-link]",
    );
    let menuOpen = false;

    const setMenu = (open: boolean) => {
        if (!menu) return;
        menuOpen = open;
        if (open) {
            menu.style.maxHeight = `${menu.scrollHeight}px`;
            menu.classList.add("border-black/5");
            menu.classList.remove("border-transparent");
            mobile?.setAttribute("aria-label", "Cerrar menú");
            menuIcon?.setAttribute("d", "M6 18L18 6M6 6l12 12");
        } else {
            menu.style.maxHeight = "0px";
            menu.classList.remove("border-black/5");
            menu.classList.add("border-transparent");
            mobile?.setAttribute("aria-label", "Abrir menú");
            menuIcon?.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        }
    };

    mobile?.addEventListener("click", () => setMenu(!menuOpen));
    menuLinks.forEach((link) =>
        link.addEventListener("click", () => setMenu(false)),
    );

    // Cerrar al redimensionar a desktop
    window.addEventListener("resize", () => {
        if (window.innerWidth >= 768 && menuOpen) setMenu(false);
    });
</script>

<style is:global>
    [data-header].is-scrolled {
        background-color: rgba(255, 255, 255, 0.85);
        box-shadow: 0 4px 20px -10px rgba(0, 0, 0, 0.1);
    }
</style>
