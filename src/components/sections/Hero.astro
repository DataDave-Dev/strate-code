---
import Section from "../common/Section.astro";
import Logo from "../Icons/Logo.astro";
---

<Section
    id="hero"
    class="relative text-black px-5 sm:px-6 md:px-8 lg:px-12 rounded-3xl sm:rounded-4xl overflow-hidden"
>
    <div
        class="relative w-full max-w-6xl mx-auto grid md:grid-cols-2 gap-10 sm:gap-12 md:gap-16 items-center"
    >
        <!-- Texto -->
        <div class="order-2 md:order-1">
            <h1
                data-hero-heading
                class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight tracking-tight"
            >
                Diseñamos experiencias digitales que elevan su marca
            </h1>

            <p
                data-hero-text
                class="mt-5 sm:mt-6 text-gray-600 text-base sm:text-lg max-w-md"
            >
                Sitios web, apps a medida y Business Intelligence — todo en una
                sola web, con criterio y resultados reales.
            </p>

            <div class="mt-8 sm:mt-10 flex flex-wrap gap-4 sm:gap-6 items-center">
                <a
                    data-hero-cta
                    href="#contact"
                    class="border border-black px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:bg-black hover:text-white transition duration-300"
                >
                    Comenzar
                </a>

                <a
                    data-hero-cta
                    href="#projects"
                    class="text-gray-500 text-sm sm:text-base hover:text-black transition duration-300"
                >
                    Ver proyectos
                </a>
            </div>
        </div>

        <!-- Logo -->
        <div data-hero-logo class="flex justify-center order-1 md:order-2">
            <Logo class="w-32 h-32 sm:w-40 sm:h-40 md:w-44 md:h-44 lg:w-48 lg:h-48" />
        </div>
    </div>
</Section>

<style>
    [data-hero-heading] .word {
        display: inline-block;
        overflow: hidden;
        vertical-align: top;
        line-height: 1.1;
        padding-bottom: 0.05em;
    }
    [data-hero-heading] .word > span {
        display: inline-block;
        will-change: transform;
    }
    /* hide until GSAP applies initial state, prevents FOUC */
    :global(html:not(.hero-ready)) [data-hero-heading],
    :global(html:not(.hero-ready)) [data-hero-text],
    :global(html:not(.hero-ready)) [data-hero-cta],
    :global(html:not(.hero-ready)) [data-hero-logo] svg {
        visibility: hidden;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const heading = document.querySelector<HTMLElement>("[data-hero-heading]");
    const subtitle = document.querySelector<HTMLElement>("[data-hero-text]");
    const ctas = document.querySelectorAll<HTMLElement>("[data-hero-cta]");
    const logoWrap = document.querySelector<HTMLElement>("[data-hero-logo]");
    const logoSvg = logoWrap?.querySelector<SVGElement>("svg");

    if (heading) {
        const words = heading.textContent?.trim().split(/\s+/) ?? [];
        heading.innerHTML = words
            .map((w) => `<span class="word"><span>${w}</span></span>`)
            .join(" ");
    }

    // autoAlpha = opacity + visibility:hidden cuando es 0 (mejor rendimiento)
    gsap.set([subtitle, ...ctas], { autoAlpha: 0, y: 24 });
    gsap.set(logoSvg, { autoAlpha: 0, scale: 0.4, rotate: -25 });
    // Usar scale pequeño en lugar de blur para mejor rendimiento
    gsap.set("[data-hero-heading] .word > span", {
        yPercent: 110,
        rotate: 8,
        scale: 0.85,
        autoAlpha: 0,
    });
    document.documentElement.classList.add("hero-ready");

    const run = () => {
        const tl = gsap.timeline({
            defaults: { ease: "power3.out" },
            delay: 0.6,
        });

        tl.to("[data-hero-heading] .word > span", {
            yPercent: 0,
            rotate: 0,
            scale: 1,
            autoAlpha: 1,
            duration: 1.1,
            stagger: 0.09,
            ease: "power3.out", // Más suave y consistente que expo
        })
            .to(
                subtitle,
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.7,
                },
                "-=0.5",
            )
            .to(
                ctas,
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.1,
                },
                "-=0.4",
            )
            .to(
                logoSvg,
                {
                    autoAlpha: 1,
                    scale: 1,
                    rotate: 0,
                    duration: 1.1,
                    ease: "back.out(1.5)",
                },
                "-=1.1",
            )
            .add(() => {
                if (logoSvg) {
                    // Guardar referencia para cleanup
                    const floatAnimation = gsap.to(logoSvg, {
                        y: -14,
                        duration: 2.6,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });

                    // Pausar cuando el hero sale del viewport para ahorrar recursos
                    ScrollTrigger.create({
                        trigger: "#hero",
                        start: "top top",
                        end: "bottom top",
                        onLeave: () => floatAnimation.pause(),
                        onEnterBack: () => floatAnimation.play(),
                    });
                }
            });

        if (logoWrap) {
            gsap.to(logoWrap, {
                yPercent: -25,
                ease: "none",
                scrollTrigger: {
                    trigger: "#hero",
                    start: "top top",
                    end: "bottom top",
                    scrub: true,
                    refreshPriority: -1, // Hero es la primera sección
                },
            });
        }
    };

    if (document.fonts && "ready" in document.fonts) {
        document.fonts.ready.then(run);
    } else {
        run();
    }
</script>
