---
import Section from "../common/Section.astro";
import HeroLogo3D from "../three/HeroLogo3D.astro";
---

<Section
    id="hero"
    class="relative text-fg px-5 sm:px-6 md:px-8 lg:px-12 rounded-3xl sm:rounded-4xl overflow-hidden"
>
    <div
        class="relative w-full max-w-6xl mx-auto grid md:grid-cols-2 gap-10 sm:gap-12 md:gap-16 items-center"
    >
        <!-- Texto -->
        <div class="order-2 md:order-1">
            <span
                data-hero-eyebrow
                class="inline-flex items-center gap-2 text-[10px] sm:text-xs uppercase tracking-[0.2em] text-fg-muted"
            >
                <span class="w-5 sm:w-6 h-px bg-accent"></span>
                Estudio digital · 2026
            </span>

            <h1
                data-hero-heading
                class="mt-4 sm:mt-6 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight tracking-tight"
            >
                Diseñamos experiencias digitales que elevan su marca
            </h1>

            <p
                data-hero-text
                class="mt-5 sm:mt-6 text-fg-muted text-base sm:text-lg max-w-md"
            >
                Sitios web, apps a medida y Business Intelligence — todo en una
                sola web, con criterio y resultados reales.
            </p>

            <div class="mt-8 sm:mt-10 flex flex-wrap gap-4 sm:gap-6 items-center">
                <a
                    data-hero-cta
                    href="#contact"
                    class="bg-accent text-bg font-medium px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:glow-ring hover:-translate-y-0.5 transition duration-300"
                >
                    Comenzar
                </a>

                <a
                    data-hero-cta
                    href="#projects"
                    class="text-fg-muted text-sm sm:text-base hover:text-fg transition duration-300"
                >
                    Ver proyectos
                </a>
            </div>
        </div>

        <!-- Logo 3D -->
        <div data-hero-logo class="flex justify-center order-1 md:order-2">
            <HeroLogo3D />
        </div>
    </div>
</Section>

<style>
    [data-hero-heading] .word {
        display: inline-block;
        overflow: hidden;
        vertical-align: top;
        line-height: 1.1;
        padding-bottom: 0.05em;
    }
    [data-hero-heading] .word > span {
        display: inline-block;
        will-change: transform;
    }
    /* hide until GSAP applies initial state, prevents FOUC */
    :global(html:not(.hero-ready)) [data-hero-eyebrow],
    :global(html:not(.hero-ready)) [data-hero-heading],
    :global(html:not(.hero-ready)) [data-hero-text],
    :global(html:not(.hero-ready)) [data-hero-cta] {
        visibility: hidden;
    }
</style>

<script>
    import { gsap } from "gsap";

    const eyebrow = document.querySelector<HTMLElement>("[data-hero-eyebrow]");
    const heading = document.querySelector<HTMLElement>("[data-hero-heading]");
    const subtitle = document.querySelector<HTMLElement>("[data-hero-text]");
    const ctas = document.querySelectorAll<HTMLElement>("[data-hero-cta]");

    if (heading) {
        const words = heading.textContent?.trim().split(/\s+/) ?? [];
        heading.innerHTML = words
            .map((w) => `<span class="word"><span>${w}</span></span>`)
            .join(" ");
    }

    // autoAlpha = opacity + visibility:hidden cuando es 0 (mejor rendimiento)
    gsap.set([eyebrow, subtitle, ...ctas], { autoAlpha: 0, y: 24 });
    // Usar scale pequeño en lugar de blur para mejor rendimiento
    gsap.set("[data-hero-heading] .word > span", {
        yPercent: 110,
        rotate: 8,
        scale: 0.85,
        autoAlpha: 0,
    });
    document.documentElement.classList.add("hero-ready");

    const run = () => {
        const tl = gsap.timeline({
            defaults: { ease: "power3.out" },
            delay: 0.35,
        });

        tl.to(eyebrow, { autoAlpha: 1, y: 0, duration: 0.6 })
            .to(
                "[data-hero-heading] .word > span",
                {
                    yPercent: 0,
                    rotate: 0,
                    scale: 1,
                    autoAlpha: 1,
                    duration: 1.1,
                    stagger: 0.09,
                    ease: "power3.out",
                },
                "-=0.3",
            )
            .to(
                subtitle,
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.7,
                },
                "-=0.5",
            )
            .to(
                ctas,
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.1,
                },
                "-=0.4",
            );
    };

    if (document.fonts && "ready" in document.fonts) {
        document.fonts.ready.then(run);
    } else {
        run();
    }
</script>
