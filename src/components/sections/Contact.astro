---
import Section from "../common/Section.astro";

const channels = [
    {
        label: "Email",
        value: "hola@stratecode.com",
        href: "mailto:hola@stratecode.com",
    },
    {
        label: "WhatsApp",
        value: "+52 000 000 0000",
        href: "https://wa.me/520000000000",
    },
    {
        label: "Ubicación",
        value: "Trabajamos 100% remoto",
        href: null,
    },
];

const projectTypes = [
    "Sitio Web",
    "App Web",
    "Business Intelligence",
    "Consultoría",
    "Otro",
];
---

<Section
    id="Contact"
    class="!h-auto flex-col rounded-4xl px-6 md:px-12 lg:px-20 !py-32"
>
    <div class="max-w-6xl mx-auto w-full">
        <!-- Encabezado -->
        <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-end mb-20">
            <div class="md:col-span-7">
                <span
                    data-contact-eyebrow
                    class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gray-500"
                >
                    <span class="w-6 h-px bg-gray-400"></span>
                    Contacto
                </span>

                <h2
                    data-contact-heading
                    class="mt-6 text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight"
                >
                    Contanos tu idea, <span
                        class="italic font-light text-gray-500"
                        >la hacemos realidad.</span
                    >
                </h2>
            </div>

            <div class="md:col-span-5">
                <p
                    data-contact-paragraph
                    class="text-base md:text-lg text-gray-600 leading-relaxed"
                >
                    Respondemos en menos de 24 horas. Si tu proyecto encaja con
                    lo que hacemos, agendamos una llamada gratuita para entender
                    qué necesitás — sin compromiso, sin presión de venta.
                </p>
            </div>
        </div>

        <!-- Cuerpo: canales + formulario -->
        <div
            class="grid md:grid-cols-12 gap-px bg-gray-200 rounded-3xl overflow-hidden border border-gray-200"
        >
            <!-- Canales -->
            <div
                data-contact-channels
                class="md:col-span-5 bg-white p-8 md:p-12 flex flex-col justify-between gap-12"
            >
                <div>
                    <h3 class="text-xl font-semibold mb-8 tracking-tight">
                        Canales directos
                    </h3>

                    <ul class="space-y-7">
                        {
                            channels.map((c) => (
                                <li data-contact-channel>
                                    <span class="block text-xs uppercase tracking-[0.2em] text-gray-400 mb-2">
                                        {c.label}
                                    </span>
                                    {c.href ? (
                                        <a
                                            href={c.href}
                                            class="group inline-flex items-center gap-2 text-base md:text-lg font-medium hover:text-gray-500 transition-colors"
                                        >
                                            {c.value}
                                            <svg
                                                width="14"
                                                height="14"
                                                viewBox="0 0 14 14"
                                                fill="none"
                                                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
                                            >
                                                <path
                                                    d="M1 13L13 1M13 1H3M13 1V11"
                                                    stroke="currentColor"
                                                    stroke-width="1.5"
                                                />
                                            </svg>
                                        </a>
                                    ) : (
                                        <span class="text-base md:text-lg font-medium">
                                            {c.value}
                                        </span>
                                    )}
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Estado de disponibilidad -->
                <div class="border-t border-black/10 pt-6">
                    <div class="flex items-center gap-2 text-sm">
                        <span
                            class="w-2 h-2 rounded-full bg-green-500 animate-pulse"
                        ></span>
                        <span class="text-gray-600">
                            Disponible para nuevos proyectos
                        </span>
                    </div>
                    <p class="text-xs text-gray-400 mt-2">
                        Cupos limitados este trimestre
                    </p>
                </div>
            </div>

            <!-- Formulario -->
            <form
                data-contact-form
                class="md:col-span-7 bg-white p-8 md:p-12 flex flex-col gap-6"
            >
                <div data-contact-field class="grid md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-2">
                        <label
                            for="name"
                            class="text-xs uppercase tracking-[0.2em] text-gray-500"
                        >
                            Nombre
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            placeholder="Tu nombre"
                            class="bg-transparent border-b border-black/15 focus:border-black py-2 outline-none transition-colors placeholder:text-gray-300"
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            for="email"
                            class="text-xs uppercase tracking-[0.2em] text-gray-500"
                        >
                            Email
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder="tu@email.com"
                            class="bg-transparent border-b border-black/15 focus:border-black py-2 outline-none transition-colors placeholder:text-gray-300"
                        />
                    </div>
                </div>

                <div data-contact-field class="flex flex-col gap-3">
                    <span
                        class="text-xs uppercase tracking-[0.2em] text-gray-500"
                    >
                        Tipo de proyecto
                    </span>
                    <div class="flex flex-wrap gap-2">
                        {
                            projectTypes.map((type, i) => (
                                <label class="cursor-pointer">
                                    <input
                                        type="radio"
                                        name="projectType"
                                        value={type}
                                        class="peer sr-only"
                                        checked={i === 0}
                                    />
                                    <span class="inline-block text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-black/15 text-gray-600 peer-checked:bg-black peer-checked:text-white peer-checked:border-black hover:border-black/40 transition-all">
                                        {type}
                                    </span>
                                </label>
                            ))
                        }
                    </div>
                </div>

                <div data-contact-field class="flex flex-col gap-2">
                    <label
                        for="message"
                        class="text-xs uppercase tracking-[0.2em] text-gray-500"
                    >
                        Contanos sobre tu proyecto
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        required
                        placeholder="¿Qué tenés en mente? Cuanto más detalle, mejor."
                        class="bg-transparent border-b border-black/15 focus:border-black py-2 outline-none transition-colors placeholder:text-gray-300 resize-none"
                    ></textarea>
                </div>

                <div
                    data-contact-field
                    class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-4"
                >
                    <p class="text-xs text-gray-400 max-w-xs">
                        Al enviar aceptás que te contactemos por email.
                        Respetamos tu privacidad.
                    </p>
                    <button
                        type="submit"
                        class="group inline-flex items-center justify-center gap-3 bg-black text-white px-8 py-3.5 rounded-full hover:bg-gray-800 transition duration-300"
                    >
                        Enviar mensaje
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 14 14"
                            fill="none"
                            class="group-hover:translate-x-1 transition-transform duration-300"
                        >
                            <path
                                d="M1 13L13 1M13 1H3M13 1V11"
                                stroke="currentColor"
                                stroke-width="1.5"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
</Section>

<style>
    :global(html:not(.contact-ready)) [data-contact-eyebrow],
    :global(html:not(.contact-ready)) [data-contact-heading],
    :global(html:not(.contact-ready)) [data-contact-paragraph],
    :global(html:not(.contact-ready)) [data-contact-channels],
    :global(html:not(.contact-ready)) [data-contact-form],
    :global(html:not(.contact-ready)) [data-contact-field] {
        opacity: 0;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const eyebrow = document.querySelector<HTMLElement>(
        "[data-contact-eyebrow]",
    );
    const heading = document.querySelector<HTMLElement>(
        "[data-contact-heading]",
    );
    const paragraph = document.querySelector<HTMLElement>(
        "[data-contact-paragraph]",
    );
    const channels = document.querySelector<HTMLElement>(
        "[data-contact-channels]",
    );
    const form = document.querySelector<HTMLElement>("[data-contact-form]");
    const fields = document.querySelectorAll<HTMLElement>(
        "[data-contact-field]",
    );
    const channelItems = document.querySelectorAll<HTMLElement>(
        "[data-contact-channel]",
    );

    gsap.set([eyebrow, heading, paragraph], { opacity: 0, y: 30 });
    gsap.set([channels, form], { opacity: 0, y: 40 });
    gsap.set(fields, { opacity: 0, y: 20 });
    gsap.set(channelItems, { opacity: 0, x: -20 });

    document.documentElement.classList.add("contact-ready");

    const intro = gsap.timeline({
        defaults: { ease: "power3.out", duration: 0.8 },
        scrollTrigger: {
            trigger: "#contacto",
            start: "top 75%",
        },
    });

    intro
        .to(eyebrow, { opacity: 1, y: 0, duration: 0.5 })
        .to(heading, { opacity: 1, y: 0 }, "-=0.2")
        .to(paragraph, { opacity: 1, y: 0 }, "-=0.5");

    const body = gsap.timeline({
        defaults: { ease: "power3.out", duration: 0.7 },
        scrollTrigger: {
            trigger: channels,
            start: "top 85%",
        },
    });

    body.to(channels, { opacity: 1, y: 0 })
        .to(
            channelItems,
            { opacity: 1, x: 0, stagger: 0.08, duration: 0.5 },
            "-=0.4",
        )
        .to(form, { opacity: 1, y: 0 }, "-=0.6")
        .to(
            fields,
            { opacity: 1, y: 0, stagger: 0.08, duration: 0.5 },
            "-=0.4",
        );

    // Submit handler — placeholder
    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const formData = new FormData(form as HTMLFormElement);
        console.log("Contact form submitted:", Object.fromEntries(formData));
        alert("¡Gracias! Te contactaremos pronto.");
        (form as HTMLFormElement).reset();
    });
</script>
