---
import Section from "../common/Section.astro";
import MomentBI from "./services/MomentBI.astro";
import MomentSites from "./services/MomentSites.astro";
import MomentAppsErps from "./services/MomentAppsErps.astro";
import MomentDataConsolidation from "./services/MomentDataConsolidation.astro";
import MomentAi from "./services/MomentAi.astro";
import MomentConsulting from "./services/MomentConsulting.astro";

const services = [
    {
        title: "Business Intelligence",
        description:
            "Convertimos sus datos en decisiones. Dashboards interactivos, KPIs en tiempo real y reportes automáticos accesibles desde cualquier navegador.",
        features: ["Dashboards en vivo", "KPIs · Métricas", "Reportes automáticos"],
        icon: "chart",
        anchor: "#data-pipeline",
    },
    {
        title: "Consolidación de datos",
        description:
            "Unificamos las fuentes que ya utiliza — varios ERPs, CRMs, hojas, APIs — en un único data layer limpio y consultable. Base sólida para reportes, dashboards o IA.",
        features: ["Integraciones", "ETL · Pipelines", "Data warehouse"],
        icon: "merge",
        anchor: "#moment-data",
    },
    {
        title: "Implementación de IA",
        description:
            "Llevamos IA a su negocio con criterio: chatbots, agentes que automatizan procesos, integraciones con OpenAI / Claude y modelos a medida según el caso.",
        features: ["Chatbots · Agentes", "Automatizaciones", "OpenAI · Claude"],
        icon: "ai",
        anchor: "#moment-ai",
    },
    {
        title: "Apps Web",
        description:
            "Sistemas a medida: ERPs, paneles administrativos, gestores y plataformas internas para automatizar la operación de pequeñas y medianas empresas.",
        features: ["ERPs · CRMs", "Autenticación", "APIs · Bases de datos"],
        icon: "dashboard",
        anchor: "#moment-apps",
    },
    {
        title: "Sitios Web",
        description:
            "Páginas de aterrizaje y sitios corporativos con diseño a medida, optimizados para velocidad, SEO y conversión real.",
        features: ["Diseño UI/UX", "Alto rendimiento", "SEO técnico"],
        icon: "browser",
        anchor: "#moment-sites",
    },
    {
        title: "Consultoría",
        description:
            "Lo acompañamos en decisiones de producto, tecnología y estrategia digital con criterio profesional.",
        features: ["Auditoría técnica", "Estrategia digital", "Roadmap"],
        icon: "network",
        anchor: "#moment-consulting",
    },
];
---

<Section
    id="services"
    class="!min-h-0 flex-col rounded-3xl sm:rounded-4xl px-5 sm:px-6 md:px-10 lg:px-16 xl:px-20 !py-20 sm:!py-24 md:!py-28 lg:!py-32"
>
    <div class="max-w-6xl mx-auto w-full">
        <!-- Encabezado -->
        <div
            class="grid md:grid-cols-12 gap-6 sm:gap-8 md:gap-12 lg:gap-16 items-end mb-12 sm:mb-16 md:mb-20"
        >
            <div class="md:col-span-7">
                <span
                    data-services-eyebrow
                    class="inline-flex items-center gap-2 text-[10px] sm:text-xs uppercase tracking-[0.2em] text-gray-500"
                >
                    <span class="w-5 sm:w-6 h-px bg-gray-400"></span>
                    Servicios
                </span>

                <h2
                    data-services-heading
                    class="mt-4 sm:mt-6 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.05] tracking-tight"
                >
                    Lo que hacemos por <span
                        class="italic font-light text-gray-500">su marca.</span
                    >
                </h2>
            </div>

            <div class="md:col-span-5">
                <p
                    data-services-paragraph
                    class="text-sm sm:text-base md:text-lg text-gray-600 leading-relaxed"
                >
                    Desde la primera idea hasta el lanzamiento: combinamos
                    diseño, ingeniería y estrategia para crear productos
                    digitales que realmente funcionan. Cada servicio se adapta a
                    su proyecto — no al revés.
                </p>
            </div>
        </div>

        <!-- Grid resumen — vista rápida (cards clickeables) -->
        <div
            data-services-grid
            class="grid sm:grid-cols-2 md:grid-cols-3 gap-px bg-gray-200 rounded-2xl sm:rounded-3xl overflow-hidden border border-gray-200"
        >
            {
                services.map((s, i) => (
                    <a
                        href={s.anchor}
                        data-services-item
                        data-icon={s.icon}
                        class="relative bg-white p-6 sm:p-8 md:p-10 group hover:bg-gray-50 transition-colors duration-300 overflow-hidden block"
                    >
                        <div
                            data-services-meta
                            class="flex items-start justify-between mb-6 sm:mb-8"
                        >
                            <span class="text-xs sm:text-sm text-gray-400 font-mono">
                                0{i + 1}
                            </span>
                            <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-black/10 flex items-center justify-center group-hover:border-black/40 group-hover:rotate-45 transition-all duration-500">
                                <svg
                                    width="11"
                                    height="11"
                                    viewBox="0 0 10 10"
                                    fill="none"
                                >
                                    <path
                                        d="M1 9L9 1M9 1H2M9 1V8"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                    />
                                </svg>
                            </span>
                        </div>

                        {/* Ícono temático animado */}
                        <div
                            data-services-icon
                            class="w-12 h-12 sm:w-14 sm:h-14 mb-6 sm:mb-7 rounded-xl sm:rounded-2xl bg-gray-50 group-hover:bg-black group-hover:text-white transition-colors duration-500 flex items-center justify-center text-black"
                        >
                            {s.icon === "browser" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-browser"
                                >
                                    <rect
                                        x="3"
                                        y="5"
                                        width="22"
                                        height="18"
                                        rx="2"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        x1="3"
                                        y1="10"
                                        x2="25"
                                        y2="10"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <circle
                                        cx="6.5"
                                        cy="7.5"
                                        r="0.7"
                                        fill="currentColor"
                                    />
                                    <circle
                                        cx="9"
                                        cy="7.5"
                                        r="0.7"
                                        fill="currentColor"
                                    />
                                    <circle
                                        cx="11.5"
                                        cy="7.5"
                                        r="0.7"
                                        fill="currentColor"
                                    />
                                    <line
                                        class="browser-line browser-line-1"
                                        x1="6"
                                        y1="14"
                                        x2="18"
                                        y2="14"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    <line
                                        class="browser-line browser-line-2"
                                        x1="6"
                                        y1="17.5"
                                        x2="22"
                                        y2="17.5"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    <line
                                        class="browser-line browser-line-3"
                                        x1="6"
                                        y1="21"
                                        x2="14"
                                        y2="21"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                </svg>
                            )}
                            {s.icon === "dashboard" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-dashboard"
                                >
                                    <rect
                                        x="3"
                                        y="4"
                                        width="22"
                                        height="20"
                                        rx="2"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        x1="3"
                                        y1="9"
                                        x2="25"
                                        y2="9"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        x1="11"
                                        y1="9"
                                        x2="11"
                                        y2="24"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <rect
                                        class="dash-bar dash-bar-1"
                                        x="14"
                                        y="20"
                                        width="2.5"
                                        height="2"
                                        fill="currentColor"
                                    />
                                    <rect
                                        class="dash-bar dash-bar-2"
                                        x="18"
                                        y="17"
                                        width="2.5"
                                        height="5"
                                        fill="currentColor"
                                    />
                                    <rect
                                        class="dash-bar dash-bar-3"
                                        x="22"
                                        y="14"
                                        width="2.5"
                                        height="8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="dash-pulse"
                                        cx="7"
                                        cy="16"
                                        r="2.5"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                </svg>
                            )}
                            {s.icon === "network" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-network"
                                >
                                    <line
                                        class="net-line net-line-1"
                                        x1="14"
                                        y1="14"
                                        x2="6"
                                        y2="6"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        class="net-line net-line-2"
                                        x1="14"
                                        y1="14"
                                        x2="22"
                                        y2="6"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        class="net-line net-line-3"
                                        x1="14"
                                        y1="14"
                                        x2="6"
                                        y2="22"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        class="net-line net-line-4"
                                        x1="14"
                                        y1="14"
                                        x2="22"
                                        y2="22"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <circle
                                        class="net-node net-node-center"
                                        cx="14"
                                        cy="14"
                                        r="2.5"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="6"
                                        cy="6"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="22"
                                        cy="6"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="6"
                                        cy="22"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="22"
                                        cy="22"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                </svg>
                            )}
                            {s.icon === "merge" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-merge"
                                >
                                    {/* 3 nodos de fuente a la izquierda */}
                                    <circle
                                        cx="4"
                                        cy="6"
                                        r="1.6"
                                        fill="currentColor"
                                    />
                                    <circle
                                        cx="4"
                                        cy="14"
                                        r="1.6"
                                        fill="currentColor"
                                    />
                                    <circle
                                        cx="4"
                                        cy="22"
                                        r="1.6"
                                        fill="currentColor"
                                    />
                                    {/* 3 líneas que convergen */}
                                    <path
                                        class="merge-line merge-line-1"
                                        d="M 4 6 C 12 6, 16 14, 22 14"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    <path
                                        class="merge-line merge-line-2"
                                        d="M 4 14 L 22 14"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    <path
                                        class="merge-line merge-line-3"
                                        d="M 4 22 C 12 22, 16 14, 22 14"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    {/* Nodo destino */}
                                    <circle
                                        class="merge-target"
                                        cx="22"
                                        cy="14"
                                        r="2.6"
                                        fill="currentColor"
                                    />
                                </svg>
                            )}
                            {s.icon === "ai" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-ai"
                                >
                                    {/* Ondas concéntricas */}
                                    <circle
                                        class="ai-wave ai-wave-1"
                                        cx="14"
                                        cy="14"
                                        r="4"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <circle
                                        class="ai-wave ai-wave-2"
                                        cx="14"
                                        cy="14"
                                        r="7"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                        opacity="0.6"
                                    />
                                    <circle
                                        class="ai-wave ai-wave-3"
                                        cx="14"
                                        cy="14"
                                        r="10"
                                        stroke="currentColor"
                                        stroke-width="1"
                                        opacity="0.3"
                                    />
                                    {/* Nodo central */}
                                    <circle
                                        cx="14"
                                        cy="14"
                                        r="2"
                                        fill="currentColor"
                                    />
                                    {/* Destellos */}
                                    <path
                                        class="ai-spark ai-spark-1"
                                        d="M 14 2 L 14 5 M 12.5 3.5 L 15.5 3.5"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                        stroke-linecap="round"
                                    />
                                    <path
                                        class="ai-spark ai-spark-2"
                                        d="M 26 14 L 23 14 M 24.5 12.5 L 24.5 15.5"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                        stroke-linecap="round"
                                    />
                                    <path
                                        class="ai-spark ai-spark-3"
                                        d="M 14 26 L 14 23 M 12.5 24.5 L 15.5 24.5"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                        stroke-linecap="round"
                                    />
                                    <path
                                        class="ai-spark ai-spark-4"
                                        d="M 2 14 L 5 14 M 3.5 12.5 L 3.5 15.5"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                        stroke-linecap="round"
                                    />
                                </svg>
                            )}
                            {s.icon === "chart" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-chart"
                                >
                                    {/* Ejes */}
                                    <line
                                        x1="4"
                                        y1="4"
                                        x2="4"
                                        y2="24"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    <line
                                        x1="4"
                                        y1="24"
                                        x2="24"
                                        y2="24"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    {/* Barras */}
                                    <rect
                                        class="chart-bar chart-bar-1"
                                        x="7"
                                        y="17"
                                        width="3"
                                        height="7"
                                        fill="currentColor"
                                    />
                                    <rect
                                        class="chart-bar chart-bar-2"
                                        x="12"
                                        y="13"
                                        width="3"
                                        height="11"
                                        fill="currentColor"
                                    />
                                    <rect
                                        class="chart-bar chart-bar-3"
                                        x="17"
                                        y="9"
                                        width="3"
                                        height="15"
                                        fill="currentColor"
                                    />
                                    {/* Línea de tendencia */}
                                    <path
                                        class="chart-trend"
                                        d="M 6 17 L 13 13 L 18 9 L 22 6"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        fill="none"
                                    />
                                    {/* Punto destacado */}
                                    <circle
                                        class="chart-dot"
                                        cx="22"
                                        cy="6"
                                        r="1.6"
                                        fill="currentColor"
                                    />
                                </svg>
                            )}
                        </div>

                        <h3
                            data-services-title
                            class="text-lg sm:text-xl md:text-2xl font-semibold mb-2 sm:mb-3 tracking-tight"
                        >
                            {s.title}
                        </h3>
                        <p
                            data-services-desc
                            class="text-gray-600 leading-relaxed mb-5 sm:mb-6 text-xs sm:text-sm"
                        >
                            {s.description}
                        </p>

                        <ul
                            data-services-chips
                            class="flex flex-wrap gap-1.5 sm:gap-2"
                        >
                            {s.features.map((f) => (
                                <li class="text-[9px] sm:text-[10px] uppercase tracking-wider text-gray-500 border border-black/10 rounded-full px-2 sm:px-2.5 py-1">
                                    {f}
                                </li>
                            ))}
                        </ul>
                    </a>
                ))
            }
        </div>

        <!-- Separador "En detalle" -->
        <div
            data-services-divider
            class="mt-14 sm:mt-16 md:mt-20 flex flex-col items-center text-center"
        >
            <span class="text-[10px] sm:text-xs uppercase tracking-[0.2em] text-gray-500 mb-3">
                En detalle
            </span>
            <p class="text-base sm:text-lg text-gray-600 max-w-md">
                Cada servicio merece su propia historia.
                <span class="block text-gray-400 text-sm mt-1">Siga bajando — o haga clic en el servicio que le interese.</span>
            </p>
            <span
                class="mt-5 sm:mt-6 w-px h-12 sm:h-16 bg-gray-300"
                aria-hidden="true"
            ></span>
        </div>
    </div>
</Section>

<!-- Momentos épicos de cada servicio (orden 01→06) -->
<MomentBI />
<MomentDataConsolidation />
<MomentAi />
<MomentAppsErps />
<MomentSites />
<MomentConsulting />

<!-- CTA final después de los momentos -->
<Section
    id="services-cta"
    class="!min-h-0 flex-col rounded-3xl sm:rounded-4xl px-5 sm:px-6 md:px-10 lg:px-16 xl:px-20 !py-16 sm:!py-20 md:!py-24"
>
    <div class="max-w-6xl mx-auto w-full">
        <div
            data-services-note
            class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 sm:gap-6"
        >
            <p class="text-sm sm:text-base text-gray-600 max-w-md">
                ¿Necesita algo distinto? Conversamos cualquier proyecto que
                tenga sentido — escríbanos y veremos cómo abordarlo.
            </p>
            <a
                href="#contact"
                class="shrink-0 inline-flex items-center gap-2 sm:gap-3 border border-black px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:bg-black hover:text-white transition duration-300"
            >
                Cuéntenos su idea
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path
                        d="M1 13L13 1M13 1H3M13 1V11"
                        stroke="currentColor"
                        stroke-width="1.5"></path>
                </svg>
            </a>
        </div>
    </div>
</Section>

<style>
    :global(html:not(.services-ready)) [data-services-eyebrow],
    :global(html:not(.services-ready)) [data-services-heading],
    :global(html:not(.services-ready)) [data-services-paragraph],
    :global(html:not(.services-ready)) [data-services-item],
    :global(html:not(.services-ready)) [data-services-meta],
    :global(html:not(.services-ready)) [data-services-icon],
    :global(html:not(.services-ready)) [data-services-title],
    :global(html:not(.services-ready)) [data-services-desc],
    :global(html:not(.services-ready)) [data-services-chips],
    :global(html:not(.services-ready)) [data-services-divider],
    :global(html:not(.services-ready)) [data-services-note] {
        opacity: 0;
    }
    /* Browser icon — líneas escribiéndose */
    [data-services-item] .browser-line {
        stroke-dasharray: 24;
        stroke-dashoffset: 24;
    }
    [data-services-item][data-icon="browser"]:hover .browser-line {
        animation: browser-type 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    [data-services-item][data-icon="browser"]:hover .browser-line-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="browser"]:hover .browser-line-3 {
        animation-delay: 0.3s;
    }
    @keyframes browser-type {
        to {
            stroke-dashoffset: 0;
        }
    }
    /* Dashboard icon — barras pulsantes + nodo */
    [data-services-item] .dash-bar {
        transform-origin: bottom;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-bar {
        animation: dash-pulse 1.2s ease-in-out infinite;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-bar-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-bar-3 {
        animation-delay: 0.3s;
    }
    @keyframes dash-pulse {
        0%,
        100% {
            transform: scaleY(1);
        }
        50% {
            transform: scaleY(0.55);
        }
    }
    [data-services-item] .dash-pulse {
        transform-origin: center;
        transform-box: fill-box;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-pulse {
        animation: dash-ring 1.6s ease-out infinite;
    }
    @keyframes dash-ring {
        0% {
            transform: scale(0.6);
            opacity: 1;
        }
        100% {
            transform: scale(1.3);
            opacity: 0;
        }
    }
    /* Network icon — líneas que viajan + nodos pulsantes */
    [data-services-item] .net-line {
        stroke-dasharray: 18;
        stroke-dashoffset: 18;
    }
    [data-services-item][data-icon="network"]:hover .net-line {
        animation: net-travel 1.5s ease-out forwards;
    }
    [data-services-item][data-icon="network"]:hover .net-line-2 {
        animation-delay: 0.1s;
    }
    [data-services-item][data-icon="network"]:hover .net-line-3 {
        animation-delay: 0.2s;
    }
    [data-services-item][data-icon="network"]:hover .net-line-4 {
        animation-delay: 0.3s;
    }
    @keyframes net-travel {
        to {
            stroke-dashoffset: 0;
        }
    }
    [data-services-item] .net-node {
        transform-origin: center;
        transform-box: fill-box;
    }
    [data-services-item][data-icon="network"]:hover .net-node-center {
        animation: net-pulse 1.4s ease-in-out infinite;
    }
    @keyframes net-pulse {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.4);
        }
    }
    /* Merge icon — líneas convergiendo + nodo destino pulsante */
    [data-services-item] .merge-line {
        stroke-dasharray: 24;
        stroke-dashoffset: 24;
    }
    [data-services-item][data-icon="merge"]:hover .merge-line {
        animation: merge-draw 1.4s ease-out forwards;
    }
    [data-services-item][data-icon="merge"]:hover .merge-line-2 {
        animation-delay: 0.1s;
    }
    [data-services-item][data-icon="merge"]:hover .merge-line-3 {
        animation-delay: 0.2s;
    }
    @keyframes merge-draw {
        to {
            stroke-dashoffset: 0;
        }
    }
    [data-services-item] .merge-target {
        transform-origin: center;
        transform-box: fill-box;
    }
    [data-services-item][data-icon="merge"]:hover .merge-target {
        animation: merge-pulse 1.6s ease-in-out infinite 0.4s;
    }
    @keyframes merge-pulse {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.3);
        }
    }
    /* AI icon — ondas concéntricas + destellos parpadeando */
    [data-services-item] .ai-wave {
        transform-origin: center;
        transform-box: fill-box;
    }
    [data-services-item][data-icon="ai"]:hover .ai-wave {
        animation: ai-wave 1.8s ease-out infinite;
    }
    [data-services-item][data-icon="ai"]:hover .ai-wave-2 {
        animation-delay: 0.3s;
    }
    [data-services-item][data-icon="ai"]:hover .ai-wave-3 {
        animation-delay: 0.6s;
    }
    @keyframes ai-wave {
        0% {
            transform: scale(0.6);
            opacity: 1;
        }
        100% {
            transform: scale(1.4);
            opacity: 0;
        }
    }
    [data-services-item] .ai-spark {
        opacity: 0;
    }
    [data-services-item][data-icon="ai"]:hover .ai-spark {
        animation: ai-spark 1.2s ease-in-out infinite;
    }
    [data-services-item][data-icon="ai"]:hover .ai-spark-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="ai"]:hover .ai-spark-3 {
        animation-delay: 0.3s;
    }
    [data-services-item][data-icon="ai"]:hover .ai-spark-4 {
        animation-delay: 0.45s;
    }
    @keyframes ai-spark {
        0%,
        100% {
            opacity: 0;
        }
        50% {
            opacity: 1;
        }
    }

    /* Chart icon — barras crecen + línea se traza + punto pulsa */
    [data-services-item] .chart-bar {
        transform-origin: bottom;
        transform: scaleY(0.4);
    }
    [data-services-item][data-icon="chart"]:hover .chart-bar {
        animation: chart-grow 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    [data-services-item][data-icon="chart"]:hover .chart-bar-2 {
        animation-delay: 0.1s;
    }
    [data-services-item][data-icon="chart"]:hover .chart-bar-3 {
        animation-delay: 0.2s;
    }
    @keyframes chart-grow {
        to {
            transform: scaleY(1);
        }
    }
    [data-services-item] .chart-trend {
        stroke-dasharray: 30;
        stroke-dashoffset: 30;
    }
    [data-services-item][data-icon="chart"]:hover .chart-trend {
        animation: chart-trace 1.2s ease-out forwards 0.4s;
    }
    @keyframes chart-trace {
        to {
            stroke-dashoffset: 0;
        }
    }
    [data-services-item] .chart-dot {
        transform-origin: center;
        transform-box: fill-box;
        opacity: 0;
    }
    [data-services-item][data-icon="chart"]:hover .chart-dot {
        animation: chart-dot 1.4s ease-in-out infinite 1.4s;
    }
    @keyframes chart-dot {
        0% {
            opacity: 0;
            transform: scale(0.6);
        }
        20% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            transform: scale(1.4);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Auto-preview: dispara las mismas animaciones que :hover cuando la card
       acaba de entrar al viewport, así el visitante descubre que es interactivo */
    [data-services-item][data-icon="browser"].is-previewing .browser-line {
        animation: browser-type 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    [data-services-item][data-icon="browser"].is-previewing .browser-line-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="browser"].is-previewing .browser-line-3 {
        animation-delay: 0.3s;
    }
    [data-services-item][data-icon="dashboard"].is-previewing .dash-bar {
        animation: dash-pulse 1.2s ease-in-out infinite;
    }
    [data-services-item][data-icon="dashboard"].is-previewing .dash-bar-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="dashboard"].is-previewing .dash-bar-3 {
        animation-delay: 0.3s;
    }
    [data-services-item][data-icon="dashboard"].is-previewing .dash-pulse {
        animation: dash-ring 1.6s ease-out infinite;
    }
    [data-services-item][data-icon="network"].is-previewing .net-line {
        animation: net-travel 1.5s ease-out forwards;
    }
    [data-services-item][data-icon="network"].is-previewing .net-line-2 {
        animation-delay: 0.1s;
    }
    [data-services-item][data-icon="network"].is-previewing .net-line-3 {
        animation-delay: 0.2s;
    }
    [data-services-item][data-icon="network"].is-previewing .net-line-4 {
        animation-delay: 0.3s;
    }
    [data-services-item][data-icon="network"].is-previewing .net-node-center {
        animation: net-pulse 1.4s ease-in-out infinite;
    }
    [data-services-item][data-icon="merge"].is-previewing .merge-line {
        animation: merge-draw 1.4s ease-out forwards;
    }
    [data-services-item][data-icon="merge"].is-previewing .merge-line-2 {
        animation-delay: 0.1s;
    }
    [data-services-item][data-icon="merge"].is-previewing .merge-line-3 {
        animation-delay: 0.2s;
    }
    [data-services-item][data-icon="merge"].is-previewing .merge-target {
        animation: merge-pulse 1.6s ease-in-out infinite 0.4s;
    }
    [data-services-item][data-icon="ai"].is-previewing .ai-wave {
        animation: ai-wave 1.8s ease-out infinite;
    }
    [data-services-item][data-icon="ai"].is-previewing .ai-wave-2 {
        animation-delay: 0.3s;
    }
    [data-services-item][data-icon="ai"].is-previewing .ai-wave-3 {
        animation-delay: 0.6s;
    }
    [data-services-item][data-icon="ai"].is-previewing .ai-spark {
        animation: ai-spark 1.2s ease-in-out infinite;
    }
    [data-services-item][data-icon="ai"].is-previewing .ai-spark-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="ai"].is-previewing .ai-spark-3 {
        animation-delay: 0.3s;
    }
    [data-services-item][data-icon="ai"].is-previewing .ai-spark-4 {
        animation-delay: 0.45s;
    }
    [data-services-item][data-icon="chart"].is-previewing .chart-bar {
        animation: chart-grow 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    [data-services-item][data-icon="chart"].is-previewing .chart-bar-2 {
        animation-delay: 0.1s;
    }
    [data-services-item][data-icon="chart"].is-previewing .chart-bar-3 {
        animation-delay: 0.2s;
    }
    [data-services-item][data-icon="chart"].is-previewing .chart-trend {
        animation: chart-trace 1.2s ease-out forwards 0.4s;
    }
    [data-services-item][data-icon="chart"].is-previewing .chart-dot {
        animation: chart-dot 1.4s ease-in-out infinite 1.4s;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const eyebrow = document.querySelector<HTMLElement>(
        "[data-services-eyebrow]",
    );
    const heading = document.querySelector<HTMLElement>(
        "[data-services-heading]",
    );
    const paragraph = document.querySelector<HTMLElement>(
        "[data-services-paragraph]",
    );
    const items = document.querySelectorAll<HTMLElement>(
        "[data-services-item]",
    );
    const note = document.querySelector<HTMLElement>("[data-services-note]");
    const divider = document.querySelector<HTMLElement>(
        "[data-services-divider]",
    );

    // autoAlpha = opacity + visibility:hidden cuando es 0
    gsap.set([eyebrow, heading, paragraph], { autoAlpha: 0, y: 30 });
    gsap.set(note, { autoAlpha: 0, y: 20 });
    gsap.set(divider, { autoAlpha: 0, y: 20 });

    document.documentElement.classList.add("services-ready");

    const intro = gsap.timeline({
        defaults: { ease: "power3.out", duration: 0.8 },
        scrollTrigger: {
            trigger: "#services",
            start: "top 75%",
            refreshPriority: 0, // Services después de Hero
        },
    });

    intro
        .to(eyebrow, { autoAlpha: 1, y: 0, duration: 0.5 })
        .to(heading, { autoAlpha: 1, y: 0 }, "-=0.2")
        .to(paragraph, { autoAlpha: 1, y: 0 }, "-=0.5");

    // ========== CARDS DE SERVICIOS — entrada cinematográfica con BATCH ==========
    // Preparar estados iniciales de TODAS las cards primero
    items.forEach((item) => {
        const meta = item.querySelector<HTMLElement>("[data-services-meta]");
        const icon = item.querySelector<HTMLElement>("[data-services-icon]");
        const title = item.querySelector<HTMLElement>("[data-services-title]");
        const desc = item.querySelector<HTMLElement>("[data-services-desc]");
        const chipsContainer = item.querySelector<HTMLElement>(
            "[data-services-chips]",
        );
        const chips = chipsContainer
            ? chipsContainer.querySelectorAll<HTMLElement>("li")
            : [];

        // Estados iniciales: la card flota, los elementos internos están escondidos
        gsap.set(item, {
            autoAlpha: 0,
            y: 60,
            scale: 0.94,
        });
        gsap.set([meta, icon, title, desc], { autoAlpha: 0, y: 16 });
        gsap.set(chips, { autoAlpha: 0, scale: 0.6, y: 10 });
    });

    // Usar ScrollTrigger.batch() para coordinar la entrada de múltiples cards
    // que entran al viewport al mismo tiempo (mejor performance + código más limpio)
    ScrollTrigger.batch("[data-services-item]", {
        interval: 0.1, // agrupar callbacks dentro de 0.1s
        batchMax: 3,   // máximo 3 cards por batch (responsive: 2 cols mobile, 3 desktop)
        // markers: true, // Descomentar para debug visual de los triggers
        onEnter: (batch) => {
            // Animar cada card del batch con stagger
            batch.forEach((item, idx) => {
                const meta = item.querySelector<HTMLElement>("[data-services-meta]");
                const icon = item.querySelector<HTMLElement>("[data-services-icon]");
                const title = item.querySelector<HTMLElement>("[data-services-title]");
                const desc = item.querySelector<HTMLElement>("[data-services-desc]");
                const chipsContainer = item.querySelector<HTMLElement>(
                    "[data-services-chips]",
                );
                const chips = chipsContainer
                    ? chipsContainer.querySelectorAll<HTMLElement>("li")
                    : [];

                // Timeline por card: card entra → elementos internos en cascada
                const cardTl = gsap.timeline();

                // 1) Card aterriza con stagger por índice dentro del batch
                cardTl.to(
                    item,
                    {
                        autoAlpha: 1,
                        y: 0,
                        scale: 1,
                        duration: 0.9,
                        ease: "power3.out",
                    },
                    idx * 0.08,
                );

                // 2) Meta (número + flecha) aparece primero
                cardTl.to(
                    meta,
                    { autoAlpha: 1, y: 0, duration: 0.4, ease: "power2.out" },
                    "-=0.55",
                );

                // 3) Ícono entra con bounce
                cardTl.to(
                    icon,
                    {
                        autoAlpha: 1,
                        y: 0,
                        duration: 0.6,
                        ease: "back.out(1.6)",
                    },
                    "-=0.4",
                );

                // 4) Título sube
                cardTl.to(
                    title,
                    { autoAlpha: 1, y: 0, duration: 0.5, ease: "power3.out" },
                    "-=0.35",
                );

                // 5) Descripción entra
                cardTl.to(
                    desc,
                    { autoAlpha: 1, y: 0, duration: 0.5, ease: "power2.out" },
                    "-=0.3",
                );

                // 6) Chips con bounce stagger
                if (chips.length) {
                    cardTl.to(
                        chips,
                        {
                            autoAlpha: 1,
                            scale: 1,
                            y: 0,
                            duration: 0.45,
                            stagger: 0.06,
                            ease: "back.out(2)",
                        },
                        "-=0.25",
                    );
                }

                // 7) Auto-preview del ícono
                cardTl.add(() => {
                    item.classList.add("is-previewing");
                    window.setTimeout(() => {
                        item.classList.remove("is-previewing");
                    }, 1400);
                }, "+=0.1");
            });
        },
        onLeaveBack: (batch) => {
            // Reversa: volver al estado inicial cuando hacen scroll hacia arriba
            gsap.to(batch, {
                autoAlpha: 0,
                y: 60,
                scale: 0.94,
                duration: 0.4,
                overwrite: true,
            });
        },
        start: "top 88%",
        end: "bottom 20%",
    });

    // ========== SEPARADOR "EN DETALLE" ==========
    if (divider) {
        gsap.to(divider, {
            autoAlpha: 1,
            y: 0,
            duration: 0.7,
            ease: "power3.out",
            scrollTrigger: {
                trigger: divider,
                start: "top 90%",
            },
        });
    }

    // ========== NOTA AL PIE (después de los Moments) ==========
    gsap.to(note, {
        autoAlpha: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: {
            trigger: note,
            start: "top 90%",
        },
    });
</script>
