---
import Section from "../common/Section.astro";

const featuredService = {
    title: "Business Intelligence",
    description:
        "Convertimos sus datos en decisiones. Dashboards interactivos, KPIs en tiempo real y reportes automáticos accesibles desde cualquier navegador. Deje de mirar hojas de cálculo — comience a ver su negocio.",
    features: [
        "Dashboards en vivo",
        "KPIs · Métricas",
        "Reportes automáticos",
        "Integración con sus datos",
    ],
};

const services = [
    {
        title: "Sitios Web",
        description:
            "Páginas de aterrizaje y sitios corporativos con diseño a medida, optimizados para velocidad, SEO y conversión real.",
        features: ["Diseño UI/UX", "Alto rendimiento", "SEO técnico"],
        icon: "browser",
    },
    {
        title: "Apps Web",
        description:
            "Sistemas a medida: paneles, gestores y plataformas internas que automatizan su operación.",
        features: ["Dashboards", "Autenticación", "APIs · Bases de datos"],
        icon: "dashboard",
    },
    {
        title: "Consultoría",
        description:
            "Lo acompañamos en decisiones de producto, tecnología y estrategia digital con criterio profesional.",
        features: ["Auditoría técnica", "Estrategia digital", "Roadmap"],
        icon: "network",
    },
];
---

<Section
    id="services"
    class="!min-h-0 flex-col rounded-3xl sm:rounded-4xl px-5 sm:px-6 md:px-10 lg:px-16 xl:px-20 !py-20 sm:!py-24 md:!py-28 lg:!py-32"
>
    <div class="max-w-6xl mx-auto w-full">
        <!-- Encabezado -->
        <div class="grid md:grid-cols-12 gap-6 sm:gap-8 md:gap-12 lg:gap-16 items-end mb-12 sm:mb-16 md:mb-20">
            <div class="md:col-span-7">
                <span
                    data-services-eyebrow
                    class="inline-flex items-center gap-2 text-[10px] sm:text-xs uppercase tracking-[0.2em] text-gray-500"
                >
                    <span class="w-5 sm:w-6 h-px bg-gray-400"></span>
                    Servicios
                </span>

                <h2
                    data-services-heading
                    class="mt-4 sm:mt-6 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.05] tracking-tight"
                >
                    Lo que hacemos por <span
                        class="italic font-light text-gray-500">su marca.</span
                    >
                </h2>
            </div>

            <div class="md:col-span-5">
                <p
                    data-services-paragraph
                    class="text-sm sm:text-base md:text-lg text-gray-600 leading-relaxed"
                >
                    Desde la primera idea hasta el lanzamiento: combinamos
                    diseño, ingeniería y estrategia para crear productos
                    digitales que realmente funcionan. Cada servicio se adapta
                    a su proyecto — no al revés.
                </p>
            </div>
        </div>

        <!-- Servicio destacado: BI -->
        <div
            data-services-featured
            class="relative bg-black text-white rounded-2xl sm:rounded-3xl overflow-hidden p-6 sm:p-8 md:p-10 lg:p-12 xl:p-16 mb-px"
        >
            <div class="grid md:grid-cols-12 gap-8 sm:gap-10 md:gap-8 lg:gap-12 items-center">
                <div class="md:col-span-7 relative z-10">
                    <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-6 sm:mb-8">
                        <span
                            class="text-[10px] sm:text-xs uppercase tracking-[0.2em] text-white/50 font-mono"
                        >
                            Destacado · 01
                        </span>
                        <span
                            class="px-2.5 sm:px-3 py-1 text-[9px] sm:text-[10px] uppercase tracking-wider bg-white/10 border border-white/20 rounded-full"
                        >
                            Nuestra especialidad
                        </span>
                    </div>

                    <h3
                        class="text-2xl sm:text-3xl md:text-3xl lg:text-4xl xl:text-5xl font-semibold mb-4 sm:mb-5 tracking-tight leading-[1.05]"
                    >
                        {featuredService.title}
                    </h3>
                    <p
                        class="text-white/70 leading-relaxed text-sm sm:text-base md:text-lg max-w-xl mb-6 sm:mb-8"
                    >
                        {featuredService.description}
                    </p>

                    <ul class="flex flex-wrap gap-1.5 sm:gap-2 mb-8 sm:mb-10">
                        {
                            featuredService.features.map((f) => (
                                <li class="text-[10px] sm:text-xs uppercase tracking-wider text-white/70 border border-white/20 rounded-full px-2.5 sm:px-3 py-1 sm:py-1.5">
                                    {f}
                                </li>
                            ))
                        }
                    </ul>

                    <a
                        href="#contact"
                        class="inline-flex items-center gap-2 sm:gap-3 bg-white text-black px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:bg-gray-200 transition duration-300"
                    >
                        Quiero un dashboard
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 14 14"
                            fill="none"
                        >
                            <path
                                d="M1 13L13 1M13 1H3M13 1V11"
                                stroke="currentColor"
                                stroke-width="1.5"></path>
                        </svg>
                    </a>
                </div>

                <!-- Mock visual de dashboard -->
                <div
                    data-services-chart
                    class="md:col-span-5 relative w-full bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-4 sm:p-5 md:p-5 lg:p-6 overflow-hidden"
                >
                    <!-- Línea de scan -->
                    <div
                        data-chart-scan
                        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-green-400/60 to-transparent pointer-events-none"
                    ></div>
                    <div class="flex items-center justify-between mb-3 sm:mb-4">
                        <span
                            class="text-[10px] sm:text-xs text-white/50 uppercase tracking-wider"
                        >
                            Ventas · Este mes
                        </span>
                        <span
                            class="flex items-center gap-1.5 text-[10px] sm:text-xs text-green-400"
                        >
                            <span
                                class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"
                            ></span>
                            Live
                        </span>
                    </div>

                    <div
                        data-chart-kpi
                        class="text-2xl sm:text-3xl md:text-3xl lg:text-4xl font-semibold mb-1 tabular-nums"
                    >
                        $48.2k
                    </div>
                    <div
                        data-chart-trend
                        class="text-[10px] sm:text-xs text-green-400 mb-4 sm:mb-6 tabular-nums"
                    >
                        ↑ 12.4% vs. mes anterior
                    </div>

                    <!-- Gráfico de barras -->
                    <div class="flex items-end gap-1 sm:gap-1.5 h-20 sm:h-24 md:h-24 lg:h-28 xl:h-32 mb-4 sm:mb-5 md:mb-5 lg:mb-6">
                        {
                            [
                                40, 65, 35, 80, 55, 90, 70, 95, 60, 85, 75, 100,
                            ].map((h) => (
                                <div
                                    class="flex-1 bg-white/20 rounded-sm chart-bar"
                                    style={`height: ${h}%`}
                                />
                            ))
                        }
                    </div>

                    <div
                        class="grid grid-cols-3 gap-2 sm:gap-3 pt-3 sm:pt-4 border-t border-white/10"
                    >
                        <div class="min-w-0">
                            <div class="text-[10px] sm:text-xs text-white/50 truncate">Conversión</div>
                            <div
                                data-chart-mini
                                data-min="3"
                                data-max="5"
                                data-suffix="%"
                                data-decimals="1"
                                class="text-xs sm:text-sm font-semibold mt-0.5 tabular-nums"
                            >
                                3.8%
                            </div>
                        </div>
                        <div class="min-w-0">
                            <div class="text-[10px] sm:text-xs text-white/50 truncate">Sesiones</div>
                            <div
                                data-chart-mini
                                data-min="11"
                                data-max="14"
                                data-suffix="k"
                                data-decimals="1"
                                class="text-xs sm:text-sm font-semibold mt-0.5 tabular-nums"
                            >
                                12.4k
                            </div>
                        </div>
                        <div class="min-w-0">
                            <div class="text-[10px] sm:text-xs text-white/50 truncate">Ticket</div>
                            <div
                                data-chart-mini
                                data-min="80"
                                data-max="100"
                                data-prefix="$"
                                data-decimals="0"
                                class="text-xs sm:text-sm font-semibold mt-0.5 tabular-nums"
                            >
                                $89
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Glow decorativo -->
            <div
                class="absolute -top-32 -right-32 w-72 h-72 sm:w-96 sm:h-96 bg-white/5 rounded-full blur-3xl pointer-events-none"
            >
            </div>
        </div>

        <!-- Otros servicios -->
        <div
            class="grid sm:grid-cols-2 md:grid-cols-3 gap-px bg-gray-200 rounded-2xl sm:rounded-3xl overflow-hidden border border-gray-200"
        >
            {
                services.map((s, i) => (
                    <div
                        data-services-item
                        data-icon={s.icon}
                        class="relative bg-white p-6 sm:p-8 md:p-10 group hover:bg-gray-50 transition-colors duration-300 overflow-hidden"
                    >
                        <div class="flex items-start justify-between mb-6 sm:mb-8">
                            <span class="text-xs sm:text-sm text-gray-400 font-mono">
                                0{i + 2}
                            </span>
                            <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-black/10 flex items-center justify-center group-hover:border-black/40 group-hover:rotate-45 transition-all duration-500">
                                <svg
                                    width="11"
                                    height="11"
                                    viewBox="0 0 10 10"
                                    fill="none"
                                >
                                    <path
                                        d="M1 9L9 1M9 1H2M9 1V8"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                    />
                                </svg>
                            </span>
                        </div>

                        {/* Ícono temático animado */}
                        <div
                            data-services-icon
                            class="w-12 h-12 sm:w-14 sm:h-14 mb-6 sm:mb-7 rounded-xl sm:rounded-2xl bg-gray-50 group-hover:bg-black group-hover:text-white transition-colors duration-500 flex items-center justify-center text-black"
                        >
                            {s.icon === "browser" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-browser"
                                >
                                    <rect
                                        x="3"
                                        y="5"
                                        width="22"
                                        height="18"
                                        rx="2"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        x1="3"
                                        y1="10"
                                        x2="25"
                                        y2="10"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <circle cx="6.5" cy="7.5" r="0.7" fill="currentColor" />
                                    <circle cx="9" cy="7.5" r="0.7" fill="currentColor" />
                                    <circle cx="11.5" cy="7.5" r="0.7" fill="currentColor" />
                                    <line
                                        class="browser-line browser-line-1"
                                        x1="6"
                                        y1="14"
                                        x2="18"
                                        y2="14"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    <line
                                        class="browser-line browser-line-2"
                                        x1="6"
                                        y1="17.5"
                                        x2="22"
                                        y2="17.5"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                    <line
                                        class="browser-line browser-line-3"
                                        x1="6"
                                        y1="21"
                                        x2="14"
                                        y2="21"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                    />
                                </svg>
                            )}
                            {s.icon === "dashboard" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-dashboard"
                                >
                                    <rect
                                        x="3"
                                        y="4"
                                        width="22"
                                        height="20"
                                        rx="2"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        x1="3"
                                        y1="9"
                                        x2="25"
                                        y2="9"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        x1="11"
                                        y1="9"
                                        x2="11"
                                        y2="24"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <rect
                                        class="dash-bar dash-bar-1"
                                        x="14"
                                        y="20"
                                        width="2.5"
                                        height="2"
                                        fill="currentColor"
                                    />
                                    <rect
                                        class="dash-bar dash-bar-2"
                                        x="18"
                                        y="17"
                                        width="2.5"
                                        height="5"
                                        fill="currentColor"
                                    />
                                    <rect
                                        class="dash-bar dash-bar-3"
                                        x="22"
                                        y="14"
                                        width="2.5"
                                        height="8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="dash-pulse"
                                        cx="7"
                                        cy="16"
                                        r="2.5"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                </svg>
                            )}
                            {s.icon === "network" && (
                                <svg
                                    width="28"
                                    height="28"
                                    viewBox="0 0 28 28"
                                    fill="none"
                                    class="icon-network"
                                >
                                    <line
                                        class="net-line net-line-1"
                                        x1="14"
                                        y1="14"
                                        x2="6"
                                        y2="6"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        class="net-line net-line-2"
                                        x1="14"
                                        y1="14"
                                        x2="22"
                                        y2="6"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        class="net-line net-line-3"
                                        x1="14"
                                        y1="14"
                                        x2="6"
                                        y2="22"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <line
                                        class="net-line net-line-4"
                                        x1="14"
                                        y1="14"
                                        x2="22"
                                        y2="22"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                    />
                                    <circle
                                        class="net-node net-node-center"
                                        cx="14"
                                        cy="14"
                                        r="2.5"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="6"
                                        cy="6"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="22"
                                        cy="6"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="6"
                                        cy="22"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                    <circle
                                        class="net-node"
                                        cx="22"
                                        cy="22"
                                        r="1.8"
                                        fill="currentColor"
                                    />
                                </svg>
                            )}
                        </div>

                        <h3 class="text-lg sm:text-xl md:text-2xl font-semibold mb-2 sm:mb-3 tracking-tight">
                            {s.title}
                        </h3>
                        <p class="text-gray-600 leading-relaxed mb-5 sm:mb-6 text-xs sm:text-sm">
                            {s.description}
                        </p>

                        <ul class="flex flex-wrap gap-1.5 sm:gap-2">
                            {s.features.map((f) => (
                                <li class="text-[9px] sm:text-[10px] uppercase tracking-wider text-gray-500 border border-black/10 rounded-full px-2 sm:px-2.5 py-1">
                                    {f}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <!-- Nota al pie -->
        <div
            data-services-note
            class="mt-12 sm:mt-14 md:mt-16 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 sm:gap-6 pt-8 sm:pt-10 md:pt-12 border-t border-black/10"
        >
            <p class="text-sm sm:text-base text-gray-600 max-w-md">
                ¿Necesita algo distinto? Conversamos cualquier proyecto que
                tenga sentido — escríbanos y veremos cómo abordarlo.
            </p>
            <a
                href="#contact"
                class="shrink-0 inline-flex items-center gap-2 sm:gap-3 border border-black px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:bg-black hover:text-white transition duration-300"
            >
                Cuéntenos su idea
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path
                        d="M1 13L13 1M13 1H3M13 1V11"
                        stroke="currentColor"
                        stroke-width="1.5"></path>
                </svg>
            </a>
        </div>
    </div>
</Section>

<style>
    :global(html:not(.services-ready)) [data-services-eyebrow],
    :global(html:not(.services-ready)) [data-services-heading],
    :global(html:not(.services-ready)) [data-services-paragraph],
    :global(html:not(.services-ready)) [data-services-featured],
    :global(html:not(.services-ready)) [data-services-item],
    :global(html:not(.services-ready)) [data-services-note] {
        opacity: 0;
    }
    [data-services-featured] .chart-bar {
        transform-origin: bottom;
        transition: height 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-services-featured] [data-chart-kpi],
    [data-services-featured] [data-chart-trend],
    [data-services-featured] [data-chart-mini] {
        transition: filter 0.3s ease;
    }
    /* Browser icon — líneas escribiéndose */
    [data-services-item] .browser-line {
        stroke-dasharray: 24;
        stroke-dashoffset: 24;
    }
    [data-services-item][data-icon="browser"]:hover .browser-line {
        animation: browser-type 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    [data-services-item][data-icon="browser"]:hover .browser-line-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="browser"]:hover .browser-line-3 {
        animation-delay: 0.3s;
    }
    @keyframes browser-type {
        to {
            stroke-dashoffset: 0;
        }
    }
    /* Dashboard icon — barras pulsantes + nodo */
    [data-services-item] .dash-bar {
        transform-origin: bottom;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-bar {
        animation: dash-pulse 1.2s ease-in-out infinite;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-bar-2 {
        animation-delay: 0.15s;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-bar-3 {
        animation-delay: 0.3s;
    }
    @keyframes dash-pulse {
        0%, 100% {
            transform: scaleY(1);
        }
        50% {
            transform: scaleY(0.55);
        }
    }
    [data-services-item] .dash-pulse {
        transform-origin: center;
        transform-box: fill-box;
    }
    [data-services-item][data-icon="dashboard"]:hover .dash-pulse {
        animation: dash-ring 1.6s ease-out infinite;
    }
    @keyframes dash-ring {
        0% {
            transform: scale(0.6);
            opacity: 1;
        }
        100% {
            transform: scale(1.3);
            opacity: 0;
        }
    }
    /* Network icon — líneas que viajan + nodos pulsantes */
    [data-services-item] .net-line {
        stroke-dasharray: 18;
        stroke-dashoffset: 18;
    }
    [data-services-item][data-icon="network"]:hover .net-line {
        animation: net-travel 1.5s ease-out forwards;
    }
    [data-services-item][data-icon="network"]:hover .net-line-2 {
        animation-delay: 0.1s;
    }
    [data-services-item][data-icon="network"]:hover .net-line-3 {
        animation-delay: 0.2s;
    }
    [data-services-item][data-icon="network"]:hover .net-line-4 {
        animation-delay: 0.3s;
    }
    @keyframes net-travel {
        to {
            stroke-dashoffset: 0;
        }
    }
    [data-services-item] .net-node {
        transform-origin: center;
        transform-box: fill-box;
    }
    [data-services-item][data-icon="network"]:hover .net-node-center {
        animation: net-pulse 1.4s ease-in-out infinite;
    }
    @keyframes net-pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.4);
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const eyebrow = document.querySelector<HTMLElement>(
        "[data-services-eyebrow]",
    );
    const heading = document.querySelector<HTMLElement>(
        "[data-services-heading]",
    );
    const paragraph = document.querySelector<HTMLElement>(
        "[data-services-paragraph]",
    );
    const featured = document.querySelector<HTMLElement>(
        "[data-services-featured]",
    );
    const chartBars = document.querySelectorAll<HTMLElement>(
        "[data-services-featured] .chart-bar",
    );
    const items = document.querySelectorAll<HTMLElement>(
        "[data-services-item]",
    );
    const note = document.querySelector<HTMLElement>("[data-services-note]");

    gsap.set([eyebrow, heading, paragraph], { opacity: 0, y: 30 });
    gsap.set(featured, { opacity: 0, y: 40 });
    gsap.set(chartBars, { scaleY: 0 });
    gsap.set(items, { opacity: 0, y: 40 });
    gsap.set(note, { opacity: 0, y: 20 });

    document.documentElement.classList.add("services-ready");

    const intro = gsap.timeline({
        defaults: { ease: "power3.out", duration: 0.8 },
        scrollTrigger: {
            trigger: "#services",
            start: "top 75%",
        },
    });

    intro
        .to(eyebrow, { opacity: 1, y: 0, duration: 0.5 })
        .to(heading, { opacity: 1, y: 0 }, "-=0.2")
        .to(paragraph, { opacity: 1, y: 0 }, "-=0.5");

    gsap.to(featured, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
            trigger: featured,
            start: "top 80%",
            onEnter: () => {
                gsap.to(chartBars, {
                    scaleY: 1,
                    duration: 0.8,
                    stagger: 0.05,
                    ease: "power3.out",
                    delay: 0.3,
                });
                startLiveDashboard();
            },
        },
    });

    // Dashboard "vivo": KPI, barras y mini-stats se actualizan periódicamente
    const kpiEl = document.querySelector<HTMLElement>("[data-chart-kpi]");
    const trendEl = document.querySelector<HTMLElement>("[data-chart-trend]");
    const miniStats = document.querySelectorAll<HTMLElement>("[data-chart-mini]");
    const scanEl = document.querySelector<HTMLElement>("[data-chart-scan]");
    const barEls = Array.from(chartBars);

    const formatKpi = (n: number) => `$${n.toFixed(1)}k`;

    let liveStarted = false;
    const startLiveDashboard = () => {
        if (liveStarted) return;
        liveStarted = true;

        // Línea de scan en loop
        if (scanEl) {
            const parent = scanEl.parentElement;
            const updateScan = () => {
                const h = parent?.clientHeight ?? 400;
                gsap.killTweensOf(scanEl);
                gsap.set(scanEl, { y: 0, opacity: 0 });
                gsap.to(scanEl, {
                    y: h,
                    opacity: 1,
                    duration: 2.4,
                    ease: "power1.inOut",
                    repeat: -1,
                    repeatDelay: 1.6,
                    yoyo: false,
                    onRepeat: () => gsap.set(scanEl, { y: 0 }),
                });
            };
            updateScan();
            window.addEventListener("resize", updateScan);
        }

        // KPI principal: cuenta hacia arriba con pequeñas variaciones
        const kpiState = { value: 48.2 };
        const tickKpi = () => {
            const target = 47 + Math.random() * 5;
            gsap.to(kpiState, {
                value: target,
                duration: 1.2,
                ease: "power2.out",
                onUpdate: () => {
                    if (kpiEl) kpiEl.textContent = formatKpi(kpiState.value);
                },
                onComplete: () => {
                    if (trendEl) {
                        const pct = (8 + Math.random() * 8).toFixed(1);
                        trendEl.textContent = `↑ ${pct}% vs. mes anterior`;
                    }
                },
            });
        };
        gsap.delayedCall(2, tickKpi);
        setInterval(tickKpi, 4500);

        // Barras: nuevas alturas cada cierto tiempo
        const tickBars = () => {
            barEls.forEach((bar) => {
                const next = 30 + Math.random() * 70;
                (bar as HTMLElement).style.height = `${next}%`;
            });
        };
        setInterval(tickBars, 3500);

        // Mini stats: animan sus valores
        miniStats.forEach((el) => {
            const min = parseFloat(el.dataset.min ?? "0");
            const max = parseFloat(el.dataset.max ?? "100");
            const decimals = parseInt(el.dataset.decimals ?? "1");
            const prefix = el.dataset.prefix ?? "";
            const suffix = el.dataset.suffix ?? "";
            const state = { value: (min + max) / 2 };

            const tickMini = () => {
                const target = min + Math.random() * (max - min);
                gsap.to(state, {
                    value: target,
                    duration: 1.4,
                    ease: "power2.out",
                    onUpdate: () => {
                        el.textContent = `${prefix}${state.value.toFixed(decimals)}${suffix}`;
                    },
                });
            };
            gsap.delayedCall(1 + Math.random() * 2, tickMini);
            setInterval(tickMini, 4000 + Math.random() * 2000);
        });
    };

    gsap.to(items, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: "power3.out",
        scrollTrigger: {
            trigger: items[0],
            start: "top 85%",
        },
    });

    gsap.to(note, {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: {
            trigger: note,
            start: "top 90%",
        },
    });
</script>
