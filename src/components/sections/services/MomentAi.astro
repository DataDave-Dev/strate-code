---
import ServiceMomentShell from "./ServiceMomentShell.astro";

const USER_MSG = "¿Cuánto vendimos esta semana?";
const AI_MSG =
    "Esta semana vendieron $48,200 en 312 órdenes — 18% más que la semana pasada. El miércoles a las 14h fue el pico.";
---

<ServiceMomentShell
    id="moment-ai"
    momentKey="ai"
    index={3}
    total={6}
    eyebrow="IA en acción · En vivo"
    title='IA conectada a <span class="italic font-light gradient-accent">sus datos.</span>'
    description="No un chatbot genérico — un agente que conoce su negocio. Conectamos modelos como Claude y OpenAI a sus datos para responder preguntas reales en lenguaje natural."
    bgClass="bg-bg text-fg"
    ctaLabel="Quiero IA en mi negocio"
>
    <!-- Chat interface -->
    <div class="grid md:grid-cols-12 gap-6 md:gap-8 items-center">
        <div class="md:col-span-8 md:col-start-3 lg:col-span-7 lg:col-start-4 relative">
            <div
                data-ai-chat
                class="relative bg-white/5 border border-white/10 rounded-2xl backdrop-blur-sm overflow-hidden"
            >
                <!-- Header -->
                <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-white/5">
                    <div class="flex items-center gap-2">
                        <span class="w-7 h-7 rounded-full bg-white flex items-center justify-center">
                            <span class="w-2 h-2 rounded-full bg-black"></span>
                        </span>
                        <div>
                            <div class="text-xs sm:text-sm font-semibold">Asistente IA</div>
                            <div class="text-[10px] text-white/60 flex items-center gap-1">
                                <span class="w-1 h-1 rounded-full bg-green-400 animate-pulse"></span>
                                conectado a sus datos
                            </div>
                        </div>
                    </div>
                    <span class="text-[9px] sm:text-[10px] uppercase tracking-wider text-white/40 font-mono hidden sm:inline">
                        Powered by Claude
                    </span>
                </div>

                <!-- Mensajes -->
                <div class="p-4 sm:p-5 space-y-3 sm:space-y-4 min-h-[280px] sm:min-h-[320px]">
                    <!-- Mensaje del usuario -->
                    <div data-ai-user-msg class="flex justify-end">
                        <div class="bg-white/10 rounded-2xl rounded-tr-sm px-3 sm:px-4 py-2 sm:py-2.5 max-w-[80%] text-xs sm:text-sm">
                            <span data-ai-user-text></span>
                            <span data-ai-user-cursor class="inline-block w-px h-3 bg-white align-middle"></span>
                        </div>
                    </div>

                    <!-- Indicador "..." de IA pensando -->
                    <div data-ai-thinking class="flex justify-start">
                        <div class="bg-white/10 border border-white/15 rounded-2xl rounded-tl-sm px-3 sm:px-4 py-2 sm:py-2.5">
                            <div class="flex gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-white/60" data-ai-dot></span>
                                <span class="w-1.5 h-1.5 rounded-full bg-white/60" data-ai-dot></span>
                                <span class="w-1.5 h-1.5 rounded-full bg-white/60" data-ai-dot></span>
                            </div>
                        </div>
                    </div>

                    <!-- Respuesta de IA -->
                    <div data-ai-bot-msg class="flex justify-start">
                        <div class="bg-white/10 border border-white/15 rounded-2xl rounded-tl-sm px-3 sm:px-4 py-2 sm:py-2.5 max-w-[85%]">
                            <div class="text-xs sm:text-sm text-white/90">
                                <span data-ai-bot-text></span>
                                <span data-ai-bot-cursor class="inline-block w-px h-3 bg-white align-middle"></span>
                            </div>
                            <!-- Mini gráfico embedded -->
                            <div data-ai-mini-chart class="mt-3 flex items-end gap-1 h-8">
                                {[40, 55, 35, 70, 60, 90, 75].map((h) => (
                                    <span
                                        data-ai-mini-bar
                                        class="flex-1 bg-white/50 rounded-sm origin-bottom"
                                        style={`height: ${h}%`}
                                    ></span>
                                ))}
                            </div>
                            <div data-ai-mini-label class="text-[9px] text-white/40 mt-1">L M M J V S D</div>
                        </div>
                    </div>
                </div>

                <!-- Input (decorativo) -->
                <div class="border-t border-white/5 p-3 sm:p-4 flex items-center gap-2">
                    <div class="flex-1 bg-white/5 border border-white/10 rounded-full px-4 py-2 text-[11px] sm:text-xs text-white/40">
                        Pregunte sobre sus datos…
                    </div>
                    <button
                        type="button"
                        class="w-8 h-8 rounded-full bg-white flex items-center justify-center"
                        aria-label="Enviar"
                    >
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <path
                                d="M1 13L13 1M13 1H3M13 1V11"
                                stroke="black"
                                stroke-width="1.5"
                            />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Chip "Powered by" flotante -->
            <div
                data-ai-chip
                class="absolute -top-3 right-2 sm:-top-4 sm:right-2 md:-right-4 bg-white text-black px-3 py-1.5 rounded-full shadow-xl flex items-center gap-2 text-[10px] sm:text-xs font-medium z-30"
            >
                <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                Claude · OpenAI
            </div>
        </div>
    </div>
</ServiceMomentShell>

<style>
    :global(html:not(.moment-ai-ready)) [data-moment-key="ai"] [data-moment-eyebrow],
    :global(html:not(.moment-ai-ready)) [data-moment-key="ai"] [data-moment-heading],
    :global(html:not(.moment-ai-ready)) [data-moment-key="ai"] [data-moment-paragraph],
    :global(html:not(.moment-ai-ready)) [data-moment-key="ai"] [data-moment-cta] {
        opacity: 0;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector<HTMLElement>('[data-moment-key="ai"]');
    if (!section) {
        document.documentElement.classList.add("moment-ai-ready");
    } else {
        const track = section.querySelector<HTMLElement>("[data-moment-track]");
        const eyebrow = section.querySelector<HTMLElement>("[data-moment-eyebrow]");
        const heading = section.querySelector<HTMLElement>("[data-moment-heading]");
        const paragraph = section.querySelector<HTMLElement>("[data-moment-paragraph]");
        const cta = section.querySelector<HTMLElement>("[data-moment-cta]");
        const chat = section.querySelector<HTMLElement>("[data-ai-chat]");
        const userMsg = section.querySelector<HTMLElement>("[data-ai-user-msg]");
        const userText = section.querySelector<HTMLElement>("[data-ai-user-text]");
        const userCursor = section.querySelector<HTMLElement>("[data-ai-user-cursor]");
        const thinking = section.querySelector<HTMLElement>("[data-ai-thinking]");
        const dots = section.querySelectorAll<HTMLElement>("[data-ai-dot]");
        const botMsg = section.querySelector<HTMLElement>("[data-ai-bot-msg]");
        const botText = section.querySelector<HTMLElement>("[data-ai-bot-text]");
        const botCursor = section.querySelector<HTMLElement>("[data-ai-bot-cursor]");
        const miniChart = section.querySelector<HTMLElement>("[data-ai-mini-chart]");
        const miniBars = section.querySelectorAll<HTMLElement>("[data-ai-mini-bar]");
        const miniLabel = section.querySelector<HTMLElement>("[data-ai-mini-label]");
        const chip = section.querySelector<HTMLElement>("[data-ai-chip]");

        const USER_MSG = "¿Cuánto vendimos esta semana?";
        const AI_MSG =
            "Esta semana vendieron $48,200 en 312 órdenes — 18% más que la semana pasada. El miércoles a las 14h fue el pico.";

        gsap.set([eyebrow, heading, paragraph, cta], { opacity: 0, y: 20 });
        gsap.set(chat, { opacity: 0, y: 30 });
        gsap.set([userMsg, thinking, botMsg], { opacity: 0, y: 10 });
        gsap.set(miniChart, { opacity: 0 });
        gsap.set(miniBars, { scaleY: 0 });
        gsap.set(miniLabel, { opacity: 0 });
        gsap.set(chip, { opacity: 0, scale: 0.7, rotate: -10 });

        document.documentElement.classList.add("moment-ai-ready");

        const writeUser = (p: number) => {
            const len = Math.round(USER_MSG.length * p);
            if (userText) userText.textContent = USER_MSG.slice(0, len);
        };
        const writeBot = (p: number) => {
            const len = Math.round(AI_MSG.length * p);
            if (botText) botText.textContent = AI_MSG.slice(0, len);
        };

        // Cursor blink
        if (userCursor)
            gsap.to(userCursor, { opacity: 0, duration: 0.5, repeat: -1, yoyo: true, ease: "steps(1)" });
        if (botCursor)
            gsap.to(botCursor, { opacity: 0, duration: 0.5, repeat: -1, yoyo: true, ease: "steps(1)" });

        // Dots typing animation (loop independiente)
        gsap.to(dots, {
            opacity: 0.3,
            y: -3,
            duration: 0.4,
            stagger: 0.15,
            yoyo: true,
            repeat: -1,
            ease: "power2.inOut",
        });

        ScrollTrigger.matchMedia({
            "(min-width: 768px)": () => {
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: track,
                        start: "top top",
                        end: "bottom bottom",
                        scrub: 1,
                        invalidateOnRefresh: true,
                    },
                });

                tl.to(eyebrow, { opacity: 1, y: 0, duration: 0.5 }, 0);
                tl.to(heading, { opacity: 1, y: 0, duration: 0.6 }, 0.1);
                tl.to(paragraph, { opacity: 1, y: 0, duration: 0.6 }, 0.2);

                tl.to(chat, { opacity: 1, y: 0, duration: 0.7 }, 0.5);
                tl.to(chip, { opacity: 1, scale: 1, rotate: 0, duration: 0.5, ease: "back.out(1.7)" }, 0.9);

                // Usuario escribe
                tl.to(userMsg, { opacity: 1, y: 0, duration: 0.4 }, 1.2);
                const userState = { p: 0 };
                tl.to(
                    userState,
                    {
                        p: 1,
                        duration: 0.7,
                        ease: "none",
                        onUpdate: () => writeUser(userState.p),
                    },
                    1.4,
                );

                // IA piensa
                tl.to(thinking, { opacity: 1, y: 0, duration: 0.3 }, 2.2);
                // (el thinking se queda visible mientras la IA "responde")

                // IA responde
                tl.to(botMsg, { opacity: 1, y: 0, duration: 0.4 }, 2.8);
                const botState = { p: 0 };
                tl.to(
                    botState,
                    {
                        p: 1,
                        duration: 1.4,
                        ease: "none",
                        onUpdate: () => writeBot(botState.p),
                    },
                    3.0,
                );

                // Mini gráfico aparece dentro de la respuesta
                tl.to(miniChart, { opacity: 1, duration: 0.3 }, 4.0);
                tl.to(miniBars, { scaleY: 1, stagger: 0.05, duration: 0.4, ease: "power3.out" }, 4.1);
                tl.to(miniLabel, { opacity: 1, duration: 0.3 }, 4.4);

                tl.to(cta, { opacity: 1, y: 0, duration: 0.5 }, 4.5);
            },

            "(max-width: 767px)": () => {
                const intro = gsap.timeline({
                    defaults: { ease: "power3.out", duration: 0.6 },
                    scrollTrigger: {
                        trigger: section,
                        start: "top 90%",
                        toggleActions: "play none none reverse",
                    },
                });
                intro
                    .to(eyebrow, { opacity: 1, y: 0 })
                    .to(heading, { opacity: 1, y: 0 }, "-=0.3")
                    .to(paragraph, { opacity: 1, y: 0 }, "-=0.4");

                gsap.to(chat, {
                    opacity: 1,
                    y: 0,
                    duration: 0.7,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: chat,
                        start: "top 85%",
                        toggleActions: "play none none reverse",
                        onEnter: () => {
                            gsap.to(chip, {
                                opacity: 1,
                                scale: 1,
                                rotate: 0,
                                duration: 0.5,
                                delay: 0.4,
                                ease: "back.out(1.7)",
                            });

                            // Secuencia chat
                            gsap.to(userMsg, { opacity: 1, y: 0, duration: 0.4, delay: 0.7 });
                            const userState = { p: 0 };
                            gsap.to(userState, {
                                p: 1,
                                duration: 1.0,
                                delay: 0.9,
                                ease: "none",
                                onUpdate: () => writeUser(userState.p),
                            });
                            gsap.to(thinking, { opacity: 1, y: 0, duration: 0.3, delay: 2.0 });
                            gsap.to(botMsg, { opacity: 1, y: 0, duration: 0.4, delay: 2.6 });
                            const botState = { p: 0 };
                            gsap.to(botState, {
                                p: 1,
                                duration: 2.0,
                                delay: 2.8,
                                ease: "none",
                                onUpdate: () => writeBot(botState.p),
                            });
                            gsap.to(miniChart, { opacity: 1, duration: 0.3, delay: 4.5 });
                            gsap.to(miniBars, {
                                scaleY: 1,
                                stagger: 0.05,
                                duration: 0.4,
                                delay: 4.6,
                                ease: "power3.out",
                            });
                            gsap.to(miniLabel, { opacity: 1, duration: 0.3, delay: 4.9 });
                        },
                    },
                });

                gsap.to(cta, {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: cta,
                        start: "top 95%",
                        toggleActions: "play none none reverse",
                    },
                });
            },
        });
    }
</script>
