---
/**
 * Shell reutilizable para los "momentos épicos" de cada servicio.
 *
 * Cada momento es una sección con sticky-CSS pin (estilo DataPipeline):
 * - Wrapper alto (300vh) en desktop
 * - Hijo sticky que se queda fijo en el viewport mientras el wrapper se scrolea
 * - En mobile (<768px) el sticky/altura no aplica → flujo normal
 *
 * El componente provee la estructura, el contenido (mock visual) va por slot.
 */
interface Props {
    id: string;
    eyebrow: string;
    title: string; // puede contener HTML (span con cursiva)
    description: string;
    bgClass: string; // ej: "bg-stone-50 text-black" o "bg-slate-900 text-white"
    accentClass?: string; // color de líneas decorativas en el eyebrow
    ctaLabel: string;
    ctaHref?: string;
    /** Identificador único para data-attrs (ej: "sites", "apps", "ai") */
    momentKey: string;
    /** Posición dentro de la serie (ej: 1) */
    index?: number;
    /** Total de momentos (ej: 5) */
    total?: number;
    /** Altura del track sticky en md+ (default "300vh") */
    trackHeight?: string;
}

const {
    id,
    eyebrow,
    title,
    description,
    bgClass,
    accentClass = "text-current",
    ctaLabel,
    ctaHref = "#contact",
    momentKey,
    index,
    total,
    trackHeight = "300vh",
} = Astro.props;

const counter =
    index !== undefined && total !== undefined
        ? `${String(index).padStart(2, "0")} / ${String(total).padStart(2, "0")}`
        : null;
---

<section
    data-moment
    data-moment-key={momentKey}
    id={id}
    class="relative bg-transparent mx-2 sm:mx-3 md:mx-4 my-2 md:my-4"
>
    <div
        data-moment-track
        class="moment-track relative"
        style={`--track-height: ${trackHeight}`}
    >
        <div
            data-moment-pin
            class:list={[
                "relative md:sticky md:top-0 w-full md:h-screen md:max-h-screen rounded-3xl sm:rounded-4xl overflow-hidden",
                bgClass,
            ]}
        >
            <div
                class="relative max-w-6xl mx-auto px-5 sm:px-8 md:px-10 lg:px-14 xl:px-20 py-14 sm:py-16 md:py-8 lg:py-10 md:h-full flex flex-col md:justify-between"
            >
                {counter && (
                    <div
                        data-moment-counter
                        class="absolute z-20 top-4 sm:top-6 md:top-8 right-5 sm:right-8 md:right-12 lg:right-16 xl:right-20 text-[10px] sm:text-xs uppercase tracking-[0.2em] font-mono opacity-50 pointer-events-none"
                    >
                        {counter}
                    </div>
                )}
                <!-- Encabezado -->
                <div
                    class="grid md:grid-cols-12 gap-3 sm:gap-5 md:gap-8 lg:gap-12 mb-6 sm:mb-8 md:mb-5 lg:mb-8"
                >
                    <div class="md:col-span-7">
                        <span
                            data-moment-eyebrow
                            class:list={[
                                "inline-flex items-center gap-2 text-[10px] sm:text-xs uppercase tracking-[0.2em] opacity-60",
                                accentClass,
                            ]}
                        >
                            <span class:list={["w-5 sm:w-6 h-px bg-current opacity-40"]}></span>
                            {eyebrow}
                        </span>

                        <h2
                            data-moment-heading
                            class="mt-3 sm:mt-4 md:mt-3 lg:mt-4 text-2xl sm:text-3xl md:text-3xl lg:text-4xl xl:text-5xl font-semibold leading-[1.05] tracking-tight pr-12 sm:pr-16 md:pr-20"
                            set:html={title}
                        />
                    </div>
                    <div class="md:col-span-5">
                        <p
                            data-moment-paragraph
                            class="text-sm sm:text-base md:text-lg leading-relaxed opacity-70"
                        >
                            {description}
                        </p>
                    </div>
                </div>

                <!-- Mock visual (slot) -->
                <div
                    data-moment-stage
                    class="relative flex-1 min-h-0 flex flex-col justify-center"
                >
                    <slot />
                </div>

                <!-- CTA final -->
                <div
                    data-moment-cta
                    class="mt-6 sm:mt-8 md:mt-6 lg:mt-8 pt-3 md:pt-4 lg:pt-5 border-t border-current/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-6"
                >
                    <p class="text-sm sm:text-base opacity-60 max-w-md">
                        Esto que ve no es una maqueta. Es lo que entregamos.
                    </p>
                    <a
                        href={ctaHref}
                        class:list={[
                            "inline-flex items-center gap-2 sm:gap-3 px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base transition duration-300",
                            bgClass.includes("text-white")
                                ? "bg-white text-black hover:bg-gray-200"
                                : "bg-black text-white hover:bg-gray-800",
                        ]}
                    >
                        {ctaLabel}
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <path
                                d="M1 13L13 1M13 1H3M13 1V11"
                                stroke="currentColor"
                                stroke-width="1.5"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @media (min-width: 768px) {
        :global(.moment-track) {
            height: var(--track-height, 300vh);
        }
    }
</style>
