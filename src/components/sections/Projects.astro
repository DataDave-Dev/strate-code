---
import Section from "../common/Section.astro";
---

<Section
    id="projects"
    class="!h-auto flex-col rounded-4xl px-6 md:px-12 lg:px-20 !py-32"
>
    <div class="max-w-6xl mx-auto w-full">
        <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-end">
            <div class="md:col-span-7">
                <span
                    class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gray-500"
                >
                    <span class="w-6 h-px bg-gray-400"></span>
                    Proyectos
                </span>

                <h2
                    class="mt-6 text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight"
                >
                    Trabajos <span class="italic font-light text-gray-500"
                        >en camino.</span
                    >
                </h2>
            </div>

            <div class="md:col-span-5">
                <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                    Estamos preparando una selección de casos para mostrarte
                    pronto. Mientras tanto, podemos hablar de proyectos en
                    curso por privado.
                </p>
            </div>
        </div>
    </div>
</Section>
