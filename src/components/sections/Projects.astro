---
import Section from "../common/Section.astro";
import { projects } from "../../data/projects";

const statusLabels: Record<string, { label: string; classes: string }> = {
    live: {
        label: "En vivo",
        classes: "bg-green-500/10 text-green-600 border-green-500/30",
    },
    "in-progress": {
        label: "En desarrollo",
        classes: "bg-amber-500/10 text-amber-600 border-amber-500/30",
    },
    "case-study": {
        label: "Caso de estudio",
        classes: "bg-gray-500/10 text-gray-600 border-gray-500/30",
    },
};
---

<Section
    id="projects"
    class="!min-h-0 flex-col rounded-3xl sm:rounded-4xl px-5 sm:px-6 md:px-10 lg:px-16 xl:px-20 !py-20 sm:!py-24 md:!py-28 lg:!py-32"
>
    <div class="max-w-6xl mx-auto w-full">
        <!-- Encabezado -->
        <div
            class="grid md:grid-cols-12 gap-6 sm:gap-8 md:gap-12 lg:gap-16 items-end mb-12 sm:mb-16 md:mb-20"
        >
            <div class="md:col-span-7">
                <span
                    data-projects-eyebrow
                    class="inline-flex items-center gap-2 text-[10px] sm:text-xs uppercase tracking-[0.2em] text-gray-500"
                >
                    <span class="w-5 sm:w-6 h-px bg-gray-400"></span>
                    Proyectos
                </span>

                <h2
                    data-projects-heading
                    class="mt-4 sm:mt-6 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold leading-[1.05] tracking-tight"
                >
                    Trabajos <span class="italic font-light text-gray-500"
                        >que cuentan una historia.</span
                    >
                </h2>
            </div>

            <div class="md:col-span-5">
                <p
                    data-projects-paragraph
                    class="text-sm sm:text-base md:text-lg text-gray-600 leading-relaxed"
                >
                    Una selección de proyectos donde combinamos diseño,
                    ingeniería y datos para resolver problemas reales. Cada
                    uno cuenta el qué, el cómo y el resultado.
                </p>
            </div>
        </div>

        <!-- Lista de proyectos (zigzag) -->
        <div class="flex flex-col gap-12 sm:gap-16 md:gap-24 lg:gap-32">
            {
                projects.map((p, i) => {
                    const status = statusLabels[p.status];
                    const flip = i % 2 === 1;
                    return (
                        <article
                            data-project-card
                            data-flip={flip ? "true" : "false"}
                            class="relative grid md:grid-cols-12 gap-8 md:gap-10 lg:gap-14 items-center"
                        >
                            {/* Número grande decorativo (contra-parallax) */}
                            <span
                                data-project-bignum
                                class:list={[
                                    "hidden md:block absolute font-mono text-black/5 select-none pointer-events-none text-[180px] lg:text-[240px] leading-none z-0",
                                    flip
                                        ? "-right-4 lg:-right-8 -top-12"
                                        : "-left-4 lg:-left-8 -top-12",
                                ]}
                            >
                                0{i + 1}
                            </span>

                            {/* Imagen */}
                            <div
                                data-project-cover
                                class:list={[
                                    "md:col-span-7 relative z-10",
                                    flip ? "md:order-2" : "md:order-1",
                                ]}
                            >
                                {p.url ? (
                                    <a
                                        href={p.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="group block relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gray-100 aspect-[16/10] border border-black/5"
                                    >
                                        <img
                                            data-project-image
                                            src={p.cover}
                                            alt={`Captura de ${p.title}`}
                                            loading="lazy"
                                            class="absolute inset-0 w-full h-full object-cover object-top will-change-transform"
                                        />
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                                        <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 inline-flex items-center gap-2 bg-white text-black px-4 py-2 rounded-full text-xs sm:text-sm font-medium opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500">
                                            Visitar sitio
                                            <svg
                                                width="12"
                                                height="12"
                                                viewBox="0 0 14 14"
                                                fill="none"
                                            >
                                                <path
                                                    d="M1 13L13 1M13 1H3M13 1V11"
                                                    stroke="currentColor"
                                                    stroke-width="1.5"
                                                />
                                            </svg>
                                        </div>
                                    </a>
                                ) : (
                                    <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gray-100 aspect-[16/10] border border-black/5">
                                        <img
                                            data-project-image
                                            src={p.cover}
                                            alt={`Captura de ${p.title}`}
                                            loading="lazy"
                                            class="absolute inset-0 w-full h-full object-cover object-top will-change-transform"
                                        />
                                        {/* Tinte sutil para reforzar que es preview, no demo */}
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent" />
                                        {/* Badge "Avance del proyecto" */}
                                        <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 inline-flex items-center gap-2 bg-white/95 backdrop-blur text-black px-3 py-1.5 rounded-full text-[10px] sm:text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            Avance del proyecto
                                        </div>
                                    </div>
                                )}
                            </div>

                            {/* Info */}
                            <div
                                data-project-info
                                class:list={[
                                    "md:col-span-5 relative z-10",
                                    flip ? "md:order-1" : "md:order-2",
                                ]}
                            >
                                {/* Meta */}
                                <div data-project-line class="flex flex-wrap items-center gap-2 mb-4 sm:mb-5">
                                    <span class="text-xs sm:text-sm text-gray-500 font-mono">
                                        0{i + 1} / {String(projects.length).padStart(2, "0")}
                                    </span>
                                    <span class="w-1 h-1 rounded-full bg-gray-300" />
                                    <span class="text-xs sm:text-sm text-gray-500">
                                        {p.category}
                                    </span>
                                    <span class="w-1 h-1 rounded-full bg-gray-300" />
                                    <span class="text-xs sm:text-sm text-gray-500">
                                        {p.year}
                                    </span>
                                    <span
                                        class:list={[
                                            "text-[10px] uppercase tracking-wider px-2 py-1 rounded-full border",
                                            status.classes,
                                        ]}
                                    >
                                        <span class="inline-flex items-center gap-1.5">
                                            {p.status === "live" && (
                                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" />
                                            )}
                                            {status.label}
                                        </span>
                                    </span>
                                </div>

                                {/* Título */}
                                <h3 data-project-line class="text-2xl sm:text-3xl md:text-4xl font-semibold tracking-tight leading-[1.1]">
                                    {p.title}
                                </h3>
                                <p data-project-line class="mt-2 sm:mt-3 text-sm sm:text-base text-gray-500 italic">
                                    {p.tagline}
                                </p>

                                {/* Descripción */}
                                <p data-project-line class="mt-4 sm:mt-5 text-sm sm:text-base text-gray-600 leading-relaxed">
                                    {p.description}
                                </p>

                                {/* Highlights */}
                                <ul data-project-line class="mt-5 sm:mt-6 space-y-2">
                                    {p.highlights.map((h) => (
                                        <li class="flex items-start gap-2 text-sm sm:text-base text-gray-700">
                                            <svg
                                                width="14"
                                                height="14"
                                                viewBox="0 0 14 14"
                                                fill="none"
                                                class="mt-1 sm:mt-1.5 shrink-0 text-black"
                                            >
                                                <path
                                                    d="M2 7.5L5.5 11L12 3"
                                                    stroke="currentColor"
                                                    stroke-width="1.6"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                />
                                            </svg>
                                            {h}
                                        </li>
                                    ))}
                                </ul>

                                {/* Stack */}
                                <div data-project-line class="mt-6 sm:mt-7">
                                    <span class="block text-[10px] uppercase tracking-[0.2em] text-gray-400 mb-2 sm:mb-3">
                                        Stack
                                    </span>
                                    <ul class="flex flex-wrap gap-1.5 sm:gap-2">
                                        {p.stack.map((tech) => (
                                            <li
                                                data-project-chip
                                                class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-700 border border-black/15 rounded-full px-2.5 sm:px-3 py-1 sm:py-1.5"
                                            >
                                                {tech}
                                            </li>
                                        ))}
                                    </ul>
                                </div>

                                {/* CTAs */}
                                <div data-project-line class="mt-6 sm:mt-8 flex flex-wrap gap-3 sm:gap-4">
                                    {p.url && (
                                        <a
                                            href={p.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-2 bg-black text-white px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:bg-gray-800 transition duration-300"
                                        >
                                            Ver sitio
                                            <svg
                                                width="14"
                                                height="14"
                                                viewBox="0 0 14 14"
                                                fill="none"
                                            >
                                                <path
                                                    d="M1 13L13 1M13 1H3M13 1V11"
                                                    stroke="currentColor"
                                                    stroke-width="1.5"
                                                />
                                            </svg>
                                        </a>
                                    )}
                                    {p.repoUrl && (
                                        <a
                                            href={p.repoUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-2 border border-black px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:bg-black hover:text-white transition duration-300"
                                        >
                                            Repositorio
                                        </a>
                                    )}
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>

        <!-- Nota al pie / próximos -->
        <div
            data-projects-note
            class="mt-16 sm:mt-20 md:mt-24 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 sm:gap-6 pt-8 sm:pt-10 md:pt-12 border-t border-black/10"
        >
            <div>
                <p class="text-sm sm:text-base text-gray-600 max-w-md">
                    Más casos llegando pronto. Si quiere ver su proyecto aquí,
                    hablemos.
                </p>
            </div>
            <a
                href="#contact"
                class="shrink-0 inline-flex items-center gap-2 sm:gap-3 border border-black px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base hover:bg-black hover:text-white transition duration-300"
            >
                Cuéntenos su idea
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path
                        d="M1 13L13 1M13 1H3M13 1V11"
                        stroke="currentColor"
                        stroke-width="1.5"
                    />
                </svg>
            </a>
        </div>
    </div>
</Section>

<style>
    :global(html:not(.projects-ready)) [data-projects-eyebrow],
    :global(html:not(.projects-ready)) [data-projects-heading],
    :global(html:not(.projects-ready)) [data-projects-paragraph],
    :global(html:not(.projects-ready)) [data-project-cover],
    :global(html:not(.projects-ready)) [data-project-line],
    :global(html:not(.projects-ready)) [data-project-bignum],
    :global(html:not(.projects-ready)) [data-projects-note] {
        opacity: 0;
    }
    [data-project-cover] {
        will-change: transform, opacity;
    }
    [data-project-line] {
        will-change: transform, opacity;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const eyebrow = document.querySelector<HTMLElement>(
        "[data-projects-eyebrow]",
    );
    const heading = document.querySelector<HTMLElement>(
        "[data-projects-heading]",
    );
    const paragraph = document.querySelector<HTMLElement>(
        "[data-projects-paragraph]",
    );
    const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");
    const note = document.querySelector<HTMLElement>("[data-projects-note]");

    gsap.set([eyebrow, heading, paragraph], { opacity: 0, y: 30 });
    gsap.set(note, { opacity: 0, y: 20 });

    document.documentElement.classList.add("projects-ready");

    // ========== ENCABEZADO ==========
    const intro = gsap.timeline({
        defaults: { ease: "power3.out", duration: 0.8 },
        scrollTrigger: {
            trigger: "#projects",
            start: "top 75%",
        },
    });
    intro
        .to(eyebrow, { opacity: 1, y: 0, duration: 0.5 })
        .to(heading, { opacity: 1, y: 0 }, "-=0.2")
        .to(paragraph, { opacity: 1, y: 0 }, "-=0.5");

    // ========== CARDS CINEMATOGRÁFICAS ==========
    const isDesktop = window.matchMedia("(min-width: 768px)").matches;

    cards.forEach((card) => {
        const flip = card.dataset.flip === "true";
        const cover = card.querySelector<HTMLElement>("[data-project-cover]");
        const image = card.querySelector<HTMLImageElement>("[data-project-image]");
        const lines = card.querySelectorAll<HTMLElement>("[data-project-line]");
        const chips = card.querySelectorAll<HTMLElement>("[data-project-chip]");
        const bignum = card.querySelector<HTMLElement>("[data-project-bignum]");

        // Direcciones de entrada según flip:
        // - flip=false: imagen a la izquierda → entra desde IZQ; texto a la derecha → entra desde DER
        // - flip=true: imagen a la derecha → entra desde DER; texto a la izquierda → entra desde IZQ
        const coverFromX = isDesktop ? (flip ? 80 : -80) : 0;
        const linesFromX = isDesktop ? (flip ? -60 : 60) : 0;

        // Estados iniciales
        gsap.set(cover, { opacity: 0, x: coverFromX });
        gsap.set(lines, { opacity: 0, x: linesFromX, y: 12 });
        gsap.set(chips, { opacity: 0, scale: 0.7, y: 8 });
        if (bignum) gsap.set(bignum, { opacity: 0 });

        // ----- 1) ENTRADA: imagen + líneas con scrub al primer cuarto del viewport -----
        const entrance = gsap.timeline({
            scrollTrigger: {
                trigger: card,
                start: "top 90%",
                end: "top 35%",
                scrub: 0.8,
            },
        });

        entrance.to(
            cover,
            { opacity: 1, x: 0, ease: "power3.out", duration: 1 },
            0,
        );
        entrance.to(
            lines,
            {
                opacity: 1,
                x: 0,
                y: 0,
                ease: "power3.out",
                duration: 0.8,
                stagger: 0.08,
            },
            0.15,
        );

        // ----- 2) BIG NUMBER: aparece + contra-parallax durante toda la card -----
        if (bignum && isDesktop) {
            gsap.to(bignum, {
                opacity: 1,
                duration: 0.6,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: card,
                    start: "top 80%",
                    toggleActions: "play none none reverse",
                },
            });

            // Contra-parallax: el número se mueve al revés del scroll
            gsap.fromTo(
                bignum,
                { yPercent: 30 },
                {
                    yPercent: -30,
                    ease: "none",
                    scrollTrigger: {
                        trigger: card,
                        start: "top bottom",
                        end: "bottom top",
                        scrub: true,
                    },
                },
            );
        }

        // ----- 3) ZOOM-IN sutil de la imagen mientras la card está en viewport -----
        if (image && isDesktop) {
            gsap.fromTo(
                image,
                { scale: 1 },
                {
                    scale: 1.08,
                    ease: "none",
                    scrollTrigger: {
                        trigger: card,
                        start: "top bottom",
                        end: "bottom top",
                        scrub: true,
                    },
                },
            );
        }

        // ----- 4) PARALLAX INVERSO del bloque de info -----
        const info = card.querySelector<HTMLElement>("[data-project-info]");
        if (info && isDesktop) {
            gsap.fromTo(
                info,
                { yPercent: 8 },
                {
                    yPercent: -8,
                    ease: "none",
                    scrollTrigger: {
                        trigger: card,
                        start: "top bottom",
                        end: "bottom top",
                        scrub: true,
                    },
                },
            );
        }

        // ----- 5) CHIPS de stack: bounce con stagger cuando entran -----
        if (chips.length) {
            gsap.to(chips, {
                opacity: 1,
                scale: 1,
                y: 0,
                duration: 0.5,
                stagger: 0.07,
                ease: "back.out(2)",
                scrollTrigger: {
                    trigger: chips[0],
                    start: "top 88%",
                },
            });
        }
    });

    // ========== NOTA AL PIE ==========
    gsap.to(note, {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: {
            trigger: note,
            start: "top 90%",
        },
    });
</script>
